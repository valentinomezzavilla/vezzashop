<%# El kit de marca y la maqueta cuando el plan de la tienda no los incluye (son del plan Acompañado). Recibe: plan = { nivel, niveles, ... }. %>
<section class="tarjeta marca-bloqueo" aria-labelledby="marca-bloqueo-titulo">
  <div class="nivel-bloqueado" role="note">
    <%- icono('candado', { tamano: 18 }) %>
    <span>Disponible desde el plan <strong><%= plan.niveles.acompanado.titulo %></strong>. Tu plan incluye el diseño <%= plan.niveles[plan.nivel].titulo %>.<%= locals.pagosActivos ? '' : (locals.contactoPlataforma ? ` Para cambiar de plan, contactanos: ${contactoPlataforma}.` : ' Contactanos para cambiar de plan.') %></span>
    <% if (locals.pagosActivos) { %><a class="boton boton-secundario boton-chico" href="/admin/suscripcion">Ver planes</a><% } %>
  </div>
  <h2 id="marca-bloqueo-titulo">¿Cómo funciona?</h2>
  <ol class="marca-pasos">
    <li><strong>Subís el material de tu marca:</strong> tu logo, fotos y los colores que te identifican.</li>
    <li><strong>Nos contás cómo es tu marca:</strong> a qué te dedicás, qué estilo buscás y qué querés transmitir.</li>
    <li><strong>Armamos tu maqueta:</strong> una vista previa de tu tienda con todo eso, en menos de un minuto.</li>
  </ol>
</section>
