<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <%# Aplica la apariencia elegida antes de pintar, para que no parpadee entre claro y oscuro al cambiar de página. %>
  <script>try{var t=localStorage.getItem("tema");if(t==="claro"||t==="oscuro")document.documentElement.dataset.tema=t}catch(e){}</script>
  <meta name="theme-color" content="#f7f7f8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b0a0e" media="(prefers-color-scheme: dark)">
  <title><%= titulo %> · Panel</title>
  <link rel="icon" href="/vezza/icono.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/admin.css">
  <script src="/admin.js" defer></script>
</head>
<body>
<a class="saltar" href="#contenido">Ir al contenido</a>
<% if (usuario) { %>
  <%# [sección, texto, ícono, texto corto para la barra del celular] %>
  <% const secciones = [
       ['inicio', 'Inicio', 'inicio'],
       ['pedidos', 'Pedidos', 'recibo'],
       ['productos', 'Productos', 'paquete'],
       ['categorias', 'Categorías', 'carpeta'],
       ['importar', 'Carga masiva', 'planilla', 'Excel'],
       ['diseno', 'Diseño', 'paleta'],
       ['pagos', 'Envíos y pagos', 'camion', 'Envíos'],
       ['cuenta', 'Cuenta', 'usuario'],
     ] %>
  <%# En el celular, las secciones de todos los días quedan en la barra de abajo; el resto, en "Más". %>
  <% const accesosRapidos = ['inicio', 'pedidos', 'productos', 'diseno'] %>
  <% const contador = pedidosNuevos > 99 ? '99+' : pedidosNuevos %>
  <div class="app">
    <header class="barra-superior">
      <a class="barra-superior-marca" href="/admin/inicio">
        <span class="lateral-logo" aria-hidden="true"><%- icono('tienda', { tamano: 16 }) %></span>
        <span class="barra-superior-nombre"><%= nombreTienda ?? 'Tu tienda' %></span>
      </a>
      <% if (urlMiTienda) { %>
        <a class="boton-icono" href="<%= urlMiTienda %>" target="_blank" rel="noopener" aria-label="Ver mi tienda" title="Ver mi tienda"><%- icono('externo', { tamano: 18 }) %></a>
      <% } %>
    </header>

    <%# En la computadora es el menú de la izquierda; en el celular se abre desde "Más" como un panel lateral
        (sin JavaScript, con el ancla #menu-panel; admin.js lo abre y lo cierra sin tocar el historial). %>
    <aside class="lateral" id="menu-panel" aria-label="Menú del panel">
      <div class="lateral-marca">
        <span class="lateral-logo" aria-hidden="true"><%- icono('tienda', { tamano: 18 }) %></span>
        <span class="lateral-textos">
          <span class="lateral-tienda"><%= nombreTienda ?? 'Tu tienda' %></span>
          <span class="lateral-sub">Panel de administración</span>
        </span>
        <a class="boton-icono lateral-cerrar" href="#contenido" data-cerrar-menu aria-label="Cerrar el menú"><%- icono('cerrar', { tamano: 18 }) %></a>
      </div>
      <nav class="lateral-menu" aria-label="Secciones del panel">
        <% for (const [seccion, texto, nombreIcono] of secciones) { %>
          <a href="/admin/<%= seccion %>" class="menu-<%= seccion %><%= seccion === seccionActual ? ' activo' : '' %>"<%- seccion === seccionActual ? ' aria-current="page"' : '' %>>
            <%- icono(nombreIcono, { tamano: 18 }) %>
            <span><%= texto %></span>
            <% if (seccion === 'pedidos' && pedidosNuevos) { %><span class="menu-contador" aria-label="<%= pedidosNuevos %> nuevo<%= pedidosNuevos === 1 ? '' : 's' %>"><%= contador %></span><% } %>
          </a>
        <% } %>
      </nav>
      <div class="lateral-pie">
        <%- include('tema') %>
        <% if (urlMiTienda) { %>
          <a class="boton boton-secundario boton-bloque" href="<%= urlMiTienda %>" target="_blank" rel="noopener">
            <%- icono('externo', { tamano: 16 }) %> Ver mi tienda
          </a>
        <% } %>
        <form method="post" action="/admin/salir">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="boton boton-fantasma boton-bloque" type="submit"><%- icono('salir', { tamano: 16 }) %> Salir</button>
        </form>
        <div class="lateral-firma"><%- vezza({ etiqueta: true }) %></div>
      </div>
    </aside>

    <nav class="barra-inferior" aria-label="Accesos rápidos">
      <% for (const [seccion, texto, nombreIcono, corto] of secciones.filter(([s]) => accesosRapidos.includes(s))) { %>
        <a href="/admin/<%= seccion %>"<%- seccion === seccionActual ? ' class="activa" aria-current="page"' : '' %>>
          <span class="barra-inferior-icono"><%- icono(nombreIcono, { tamano: 22 }) %><% if (seccion === 'pedidos' && pedidosNuevos) { %><span class="barra-inferior-contador" aria-hidden="true"><%= contador %></span><% } %></span>
          <span><%= corto ?? texto %><% if (seccion === 'pedidos' && pedidosNuevos) { %><span class="visualmente-oculto"> (<%= pedidosNuevos %> nuevo<%= pedidosNuevos === 1 ? '' : 's' %>)</span><% } %></span>
        </a>
      <% } %>
      <% const enMas = secciones.some(([s]) => s === seccionActual && !accesosRapidos.includes(s)) %>
      <a href="#menu-panel"<%- enMas ? ' class="activa"' : '' %> data-abrir-menu aria-controls="menu-panel" aria-label="Más secciones">
        <span class="barra-inferior-icono"><%- icono('menu', { tamano: 22 }) %></span>
        <span aria-hidden="true">Más</span>
      </a>
    </nav>
    <main class="contenido" id="contenido">
<% } else { %>
  <%- include('tema', { flotante: true }) %>
  <main class="contenido contenido-solo" id="contenido">
<% } %>
<%# Un aviso con sección se muestra dentro de esa sección (por ejemplo, los de banners). %>
<% if (aviso && !aviso.seccion) { %>
  <p class="aviso aviso-<%= aviso.tipo %>" role="status"><%- icono(aviso.tipo === 'ok' ? 'check' : 'alerta', { tamano: 18 }) %><span><%= aviso.texto %></span></p>
<% } %>
<% if (locals.suspendida) { %>
  <p class="aviso aviso-error"><%- icono('candado', { tamano: 18 }) %><span><strong>Tu tienda está suspendida.</strong> Los compradores no pueden entrar. Podés mirar tus datos, pero no cambiarlos.<% if (locals.motivoSuspension) { %> Motivo: <%= motivoSuspension %>.<% } %><% if (locals.contactoPlataforma) { %> Para reactivarla, contactanos: <%= contactoPlataforma %>.<% } else { %> Contactanos para reactivarla.<% } %></span></p>
<% } %>
