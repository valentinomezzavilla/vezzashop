<%- include('parciales/cabecera', { titulo: 'Planes' }) %>
<%
  const tope = (valor) => (valor === null ? 'Sin tope' : valor);
%>
<header class="encabezado">
  <div>
    <h1>Planes</h1>
    <p class="texto-suave">Cada cliente tiene un plan. Los topes se aplican en su panel: al llegar, no puede cargar más y le avisamos que amplíe.</p>
  </div>
  <div class="acciones">
    <a class="boton" href="/plataforma/planes/nuevo"><%- icono('mas', { tamano: 18 }) %> Nuevo plan</a>
  </div>
</header>

<div class="tabla-contenedor">
  <table class="tabla tabla-planes">
    <thead>
      <tr>
        <th scope="col">Plan</th>
        <th scope="col" class="numero">Por mes</th>
        <th scope="col">Productos</th>
        <th scope="col">Fotos</th>
        <th scope="col">Banners</th>
        <th scope="col">Diseño</th>
        <th scope="col">Prueba</th>
        <th scope="col" class="numero">Clientes</th>
        <th scope="col"><span class="visualmente-oculto">Acciones</span></th>
      </tr>
    </thead>
    <tbody>
      <% for (const p of planes) { %>
        <tr>
          <td>
            <a class="celda-producto" href="/plataforma/planes/<%= p.id %>">
              <span class="celda-producto-textos">
                <span class="celda-producto-nombre"><%= p.nombre %></span>
                <% if (!p.activo) { %><span class="pastilla pastilla-ambar">Pausado</span><% } %>
              </span>
            </a>
          </td>
          <td data-etiqueta="Por mes" class="numero"><%= p.precioCentavos ? formatearPrecio(p.precioCentavos) : 'Gratis' %></td>
          <td data-etiqueta="Productos"><%= tope(p.maxProductos) %></td>
          <td data-etiqueta="Fotos por producto"><%= tope(p.maxFotos) %></td>
          <td data-etiqueta="Banners"><%= tope(p.maxBanners) %></td>
          <td data-etiqueta="Diseño"><%= niveles[p.nivelDiseno]?.titulo ?? '—' %></td>
          <td data-etiqueta="Prueba"><%= p.diasPrueba ? plural(p.diasPrueba, 'día', 'días') : '—' %><% if (p.suspenderAlVencer) { %><span class="celda-nota ayuda">cierra al vencer</span><% } %></td>
          <td data-etiqueta="Clientes" class="numero"><%= Number(p.clientes) %></td>
          <td class="celda-acciones">
            <form method="post" action="/plataforma/planes/<%= p.id %>/pausar">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="boton boton-secundario boton-chico" type="submit" title="<%= p.activo ? 'Deja de ofrecerse a clientes nuevos; los que ya lo tienen no cambian' : 'Vuelve a ofrecerse a clientes nuevos' %>"><%= p.activo ? 'Pausar' : 'Reanudar' %></button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('parciales/pie') %>
