<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VEZZA Shop · Tu tienda online, sin vueltas</title>
  <meta name="description" content="VEZZA Shop es la plataforma para vender por internet: tienda con tu propio link, carrito, checkout y un panel para manejar pedidos, productos y diseño. Probá 7 días gratis.">
  <meta name="theme-color" content="#F5F3EE">
  <link rel="icon" href="/vezza/icono.svg" type="image/svg+xml">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_AR">
  <meta property="og:site_name" content="VEZZA Shop">
  <meta property="og:title" content="VEZZA Shop · Tu tienda online, sin vueltas">
  <meta property="og:description" content="Tienda con tu propio link, carrito, checkout y panel de pedidos. Cargá tus productos con un Excel y empezá a vender. 7 días gratis.">
  <meta property="og:image" content="https://vezzashop.com/landing/img/og.png">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=Sora:wght@600&display=swap">

  <script>document.documentElement.className = 'js';</script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "VEZZA Shop",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "description": "Plataforma de tiendas online: vidriera pública, carrito, checkout y panel de administración de productos, pedidos y diseño.",
    "inLanguage": "es-AR",
    "publisher": { "@type": "Organization", "name": "VEZZA", "url": "https://vezzadev.com/", "sameAs": ["https://www.instagram.com/vezza.dev/"] },
    "offers": <%- ofertasJsonLd %>
  }
  </script>

  <style>
    /* ==========================================================================
       VEZZA Shop · landing
       Tokens de la marca VEZZA (mismos que vezzadev.com): crema, tinta e índigo.
       ========================================================================== */
    :root {
      --bg: #F5F3EE;
      --bg-2: #ECE8DF;
      --paper: #FBFAF7;
      --ink: #15131C;
      --ink-2: #514F5C;          /* 7.2:1 sobre --bg */
      --accent: #3D2FE0;         /* 7.1:1 sobre --bg */
      --accent-hover: #3226C4;
      --accent-soft: #E6E3FB;
      --on-accent: #F5F3EE;
      --ok: #17784A;
      --line: rgba(21, 19, 28, 0.16);
      --inv-bg: #15131C;
      --inv-fg: #F5F3EE;
      --inv-fg-2: #B9B6C0;
      --inv-line: rgba(245, 243, 238, 0.24);

      --font: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
      --font-label: "Sora", "Manrope", system-ui, sans-serif;

      --fs-display: clamp(2.6rem, 1.2rem + 6.2vw, 6.2rem);
      --fs-h2: clamp(2rem, 1.3rem + 3vw, 3.6rem);
      --fs-h3: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
      --fs-lead: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
      --fs-body: clamp(1rem, 0.97rem + 0.15vw, 1.0625rem);

      --gutter: clamp(1.25rem, 0.5rem + 3.5vw, 3rem);
      --section-y: clamp(4.5rem, 2.5rem + 7vw, 8.5rem);
      --container: 75rem;
      --radius: 1rem;
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      --header-h: 4.5rem;
    }

    *, *::before, *::after { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: calc(var(--header-h) + 1rem); }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    body {
      margin: 0; background: var(--bg); color: var(--ink);
      font-family: var(--font); font-size: var(--fs-body); line-height: 1.6;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
      overflow-x: clip;
    }
    img { max-width: 100%; height: auto; display: block; }
    a { color: inherit; }
    h1, h2, h3, p, ul, ol, figure, dl, dd { margin: 0; }
    ul, ol { padding: 0; list-style: none; }
    button { font: inherit; color: inherit; cursor: pointer; }
    :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
    .inv :focus-visible { outline-color: #fff; }

    .skip { position: absolute; left: 1rem; top: -4rem; background: var(--ink); color: var(--bg); padding: .6rem 1rem; border-radius: .5rem; z-index: 100; transition: top .2s; }
    .skip:focus { top: 1rem; }

    .container { width: 100%; max-width: calc(var(--container) + var(--gutter) * 2); margin-inline: auto; padding-inline: var(--gutter); }
    .section { padding-block: var(--section-y); }
    .eyebrow { font-family: var(--font-label); font-size: .8125rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.1rem; }
    .inv .eyebrow { color: #A9A3FF; }
    .h2 { font-size: var(--fs-h2); line-height: 1.04; letter-spacing: -0.03em; font-weight: 800; text-wrap: balance; }
    .lead { font-size: var(--fs-lead); line-height: 1.5; color: var(--ink-2); max-width: 46rem; text-wrap: pretty; }
    .inv .lead { color: var(--inv-fg-2); }
    .head { margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); }
    .head .lead { margin-top: 1.25rem; }
    .accent { color: var(--accent); }
    .inv .accent { color: #A9A3FF; }

    /* ---------- Botones ---------- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .6rem;
      min-height: 3rem; padding: .8rem 1.5rem; border-radius: 999px; border: 1.5px solid var(--ink);
      font-weight: 700; font-size: 1rem; text-decoration: none; line-height: 1.2;
      transition: background-color .2s var(--ease), color .2s var(--ease), transform .2s var(--ease), border-color .2s var(--ease);
    }
    .btn--primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
    .btn--primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); transform: translateY(-2px); }
    .btn--ghost { background: transparent; color: var(--ink); }
    .btn--ghost:hover { background: var(--ink); color: var(--bg); transform: translateY(-2px); }
    .btn--lg { min-height: 3.5rem; padding-inline: 1.9rem; font-size: 1.0625rem; }
    .btn--block { width: 100%; }
    .inv .btn--ghost { color: var(--inv-fg); border-color: var(--inv-line); }
    .inv .btn--ghost:hover { background: var(--inv-fg); color: var(--ink); border-color: var(--inv-fg); }
    .inv .btn--primary { background: #fff; border-color: #fff; color: var(--ink); }
    .inv .btn--primary:hover { background: #E6E3FB; border-color: #E6E3FB; }
    .arrow { transition: transform .2s var(--ease); }
    .btn:hover .arrow { transform: translateX(4px); }

    /* ---------- Header ---------- */
    .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid transparent; transition: border-color .2s; }
    .site-header.is-stuck { border-bottom-color: var(--line); }
    .site-header__inner { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
    .brand { display: inline-flex; align-items: center; gap: .7rem; text-decoration: none; font-weight: 800; letter-spacing: -0.02em; font-size: 1.25rem; }
    .brand img { height: 1.9rem; width: auto; }
    .brand span b { color: var(--accent); font-weight: 800; }
    .nav { display: flex; align-items: center; gap: 2rem; }
    .nav__list { display: flex; gap: 1.75rem; }
    .nav__link { text-decoration: none; font-weight: 600; font-size: .95rem; color: var(--ink-2); position: relative; padding-block: .4rem; }
    .nav__link::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease); }
    .nav__link:hover { color: var(--ink); }
    .nav__link:hover::after { transform: scaleX(1); }
    .nav__actions { display: flex; align-items: center; gap: 1.1rem; }
    .nav__login { font-weight: 700; font-size: .95rem; text-decoration: none; }
    .nav__login:hover { color: var(--accent); }
    .menu-toggle { display: none; background: none; border: 1.5px solid var(--ink); border-radius: 999px; padding: .5rem 1rem; font-weight: 700; min-height: 2.75rem; }
    @media (max-width: 62rem) {
      .menu-toggle { display: inline-flex; align-items: center; gap: .5rem; }
      .nav { position: fixed; inset: var(--header-h) 0 auto 0; background: var(--bg); flex-direction: column; align-items: stretch; gap: 0; padding: 1rem var(--gutter) 1.75rem; border-bottom: 1px solid var(--line); display: none; max-height: calc(100dvh - var(--header-h)); overflow: auto; }
      .nav.is-open { display: flex; }
      .nav__list { flex-direction: column; gap: 0; }
      .nav__link { display: block; padding: 1rem 0; font-size: 1.15rem; border-bottom: 1px solid var(--line); }
      .nav__link::after { display: none; }
      .nav__actions { flex-direction: column; align-items: stretch; margin-top: 1.25rem; gap: .9rem; }
      .nav__login { text-align: center; padding: .6rem; }
    }

    /* ---------- Hero ---------- */
    .hero { padding-top: clamp(2.5rem, 1rem + 5vw, 5rem); padding-bottom: clamp(3rem, 2rem + 5vw, 6rem); overflow: clip; }
    .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); align-items: center; }
    @media (min-width: 62rem) { .hero__grid { grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); } }
    .hero__tag { display: inline-flex; align-items: center; gap: .6rem; font-size: .875rem; font-weight: 700; border: 1.5px solid var(--ink); border-radius: 999px; padding: .4rem 1rem .4rem .5rem; margin-bottom: 1.75rem; background: var(--paper); }
    .hero__tag i { width: .55rem; height: .55rem; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px rgba(23, 120, 74, .18); margin-left: .5rem; }
    .hero h1 { font-size: var(--fs-display); line-height: .98; letter-spacing: -0.045em; font-weight: 800; text-wrap: balance; }
    .hero h1 em { font-style: normal; color: var(--accent); position: relative; white-space: nowrap; }
    .hero h1 em::after { content: ""; position: absolute; left: 0; right: 0; bottom: .02em; height: .09em; background: var(--accent); border-radius: 999px; transform-origin: left; animation: draw .9s .5s var(--ease) both; }
    @keyframes draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .hero .lead { margin-top: 1.75rem; max-width: 36rem; }
    .hero__cta { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2.25rem; }
    .hero__checks { display: flex; flex-wrap: wrap; gap: .6rem 1.6rem; margin-top: 2rem; font-size: .95rem; font-weight: 600; color: var(--ink-2); }
    .hero__checks li { display: inline-flex; align-items: center; gap: .5rem; }
    .check { width: 1.15rem; height: 1.15rem; flex: none; border-radius: 50%; background: var(--accent); display: inline-grid; place-items: center; }
    .check::after { content: ""; width: .32rem; height: .6rem; border: solid #fff; border-width: 0 2px 2px 0; transform: translateY(-1px) rotate(45deg) scale(.9); }

    .stage { position: relative; padding: 0 0 clamp(2.5rem, 7vw, 4rem) 0; }
    .stage .win { transform: rotate(-1.4deg); }
    .stage .phone { position: absolute; right: -1%; bottom: 0; width: 26%; min-width: 7.5rem; transform: rotate(3deg); }
    .chip { position: absolute; z-index: 3; display: flex; align-items: center; gap: .7rem; background: var(--paper); border: 1.5px solid var(--ink); border-radius: 1rem; padding: .7rem 1rem .7rem .7rem; box-shadow: 4px 4px 0 var(--ink); font-size: .8125rem; line-height: 1.3; }
    .chip b { display: block; font-size: .875rem; }
    .chip span { color: var(--ink-2); }
    .chip__icon { width: 2.25rem; height: 2.25rem; border-radius: .7rem; background: var(--accent); color: #fff; display: grid; place-items: center; flex: none; }
    .chip--a { left: -2%; top: 9%; animation: float 6s ease-in-out infinite; }
    .chip--b { left: 3%; bottom: 3%; animation: float 7s -2s ease-in-out infinite; }
    @keyframes float { 50% { transform: translateY(-8px); } }
    @media (max-width: 40rem) { .stage { padding-top: 1.75rem; } .chip--a { left: 0; top: 0; } .chip--b { display: none; } }

    /* ---------- Marcos (navegador y celular) ---------- */
    .win { border: 1.5px solid var(--ink); border-radius: .9rem; background: var(--paper); overflow: hidden; box-shadow: 8px 8px 0 var(--ink); }
    .win__bar { display: flex; align-items: center; gap: .4rem; padding: .6rem .85rem; border-bottom: 1.5px solid var(--ink); background: var(--bg-2); }
    .win__bar i { width: .65rem; height: .65rem; border-radius: 50%; border: 1.5px solid var(--ink); }
    .win__url { margin-left: .6rem; flex: 1; min-width: 0; font-size: .75rem; font-weight: 600; color: var(--ink-2); background: var(--paper); border: 1px solid var(--line); border-radius: 999px; padding: .2rem .8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .win img { width: 100%; }
    .phone { border: 1.5px solid var(--ink); border-radius: 1.6rem; background: var(--ink); padding: .4rem; box-shadow: 6px 6px 0 var(--ink); }
    .phone img { border-radius: 1.25rem; width: 100%; }

    /* ---------- Cifras ---------- */
    .strip { border-block: 1.5px solid var(--ink); background: var(--paper); }
    .strip__grid { display: grid; grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 52rem) { .strip__grid { grid-template-columns: repeat(4, 1fr); } }
    .stat { padding: 1.6rem 1.25rem; border-left: 1.5px solid var(--ink); }
    .stat:nth-child(odd) { border-left: 0; }
    .stat:nth-child(n+3) { border-top: 1.5px solid var(--ink); }
    @media (min-width: 52rem) { .stat { border-left: 1.5px solid var(--ink); border-top: 0 !important; } .stat:first-child { border-left: 0; padding-left: 0; } }
    .stat b { display: block; font-size: clamp(1.9rem, 1.4rem + 2vw, 2.8rem); letter-spacing: -0.04em; line-height: 1; font-weight: 800; }
    .stat span { display: block; margin-top: .5rem; font-size: .9rem; color: var(--ink-2); line-height: 1.4; }

    /* ---------- Qué es ---------- */
    .cards3 { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    @media (min-width: 52rem) { .cards3 { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }
    .card { background: var(--paper); border: 1.5px solid var(--ink); border-radius: var(--radius); padding: clamp(1.5rem, 1rem + 1.5vw, 2.1rem); display: flex; flex-direction: column; gap: 1rem; transition: transform .25s var(--ease), box-shadow .25s var(--ease); }
    .card:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--ink); }
    .card__n { font-family: var(--font-label); font-weight: 600; font-size: .85rem; letter-spacing: .12em; color: var(--accent); }
    .card h3 { font-size: var(--fs-h3); letter-spacing: -0.02em; line-height: 1.2; font-weight: 800; }
    .card p { color: var(--ink-2); }

    /* ---------- Pasos ---------- */
    .steps { counter-reset: paso; display: grid; gap: 0; border-top: 1.5px solid var(--ink); }
    .step { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem 2rem; padding: 1.75rem 0; border-bottom: 1.5px solid var(--ink); align-items: baseline; }
    @media (min-width: 52rem) { .step { grid-template-columns: 7rem minmax(0, 1fr) minmax(0, 1.2fr); padding: 2.25rem 0; } }
    .step__n { font-size: clamp(2.6rem, 2rem + 2.4vw, 4rem); font-weight: 800; letter-spacing: -0.05em; line-height: .9; color: var(--accent); font-variant-numeric: tabular-nums; }
    .step h3 { font-size: var(--fs-h3); letter-spacing: -0.02em; font-weight: 800; line-height: 1.2; }
    .step p { color: var(--ink-2); grid-column: 2; }
    @media (min-width: 52rem) { .step p { grid-column: auto; } }

    /* ---------- Bloques con captura ---------- */
    .split { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: center; }
    @media (min-width: 62rem) { .split { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); } .split--rev { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); } .split--rev .split__text { order: 2; } }
    .ticks { display: grid; gap: .9rem; margin-top: 1.75rem; }
    .ticks li { display: grid; grid-template-columns: auto 1fr; gap: .8rem; align-items: start; }
    .ticks .check { margin-top: .32rem; }
    .ticks b { font-weight: 700; }
    .ticks span { color: var(--ink-2); }

    .shopstage { position: relative; padding-bottom: 2.5rem; }
    .shopstage .phone { position: absolute; left: -2%; bottom: 0; width: 24%; min-width: 7rem; transform: rotate(-3deg); }

    /* ---------- Pestañas ---------- */
    .tabs { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.75rem; }
    .js .tabs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); padding-bottom: .5rem; -webkit-overflow-scrolling: touch; }
    .js .tabs::-webkit-scrollbar { display: none; }
    @media (min-width: 62rem) { .js .tabs { flex-wrap: wrap; overflow: visible; margin-inline: 0; padding-inline: 0; } }
    .tab { flex: none; min-height: 2.75rem; padding: .55rem 1.2rem; border-radius: 999px; border: 1.5px solid var(--ink); background: transparent; font-weight: 700; font-size: .95rem; transition: background-color .2s, color .2s; }
    .tab:hover { background: var(--accent-soft); }
    .tab[aria-selected="true"] { background: var(--ink); color: var(--bg); }
    .inv .tab { border-color: var(--inv-line); }
    .inv .tab:hover { background: rgba(255,255,255,.08); }
    .inv .tab[aria-selected="true"] { background: var(--inv-fg); color: var(--ink); border-color: var(--inv-fg); }
    .showcase { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.75rem, 1rem + 3vw, 3.5rem); align-items: center; }
    @media (min-width: 62rem) { .showcase { grid-template-columns: minmax(0, .62fr) minmax(0, 1.38fr); } }
    .tabpanel__text h3 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; margin-bottom: 1rem; }
    .tabpanel__text > p { color: var(--ink-2); }
    .inv .tabpanel__text > p { color: var(--inv-fg-2); }
    .tabpanel__text .ticks { margin-top: 1.25rem; }
    .inv .ticks span { color: var(--inv-fg-2); }
    .inv .check { background: #fff; }
    .inv .check::after { border-color: var(--ink); }
    .tabpanel.is-in { animation: rise .45s var(--ease) both; }
    @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    .inv .win { box-shadow: 8px 8px 0 var(--accent); border-color: var(--inv-fg); }
    .inv .win__bar { border-bottom-color: var(--inv-fg); }
    .inv .win__bar i { border-color: var(--ink); }

    /* ---------- Sección invertida ---------- */
    .inv { background: var(--inv-bg); color: var(--inv-fg); }

    /* ---------- Slogans ---------- */
    .marquee { background: var(--accent); color: #fff; overflow: hidden; border-block: 1.5px solid var(--ink); }
    .marquee__track { display: flex; width: max-content; animation: slide 38s linear infinite; }
    .marquee__group { display: flex; flex: none; }
    .marquee__item { padding: 1.1rem 0; font-size: clamp(1.2rem, 1rem + 1vw, 1.75rem); font-weight: 800; letter-spacing: -0.02em; white-space: nowrap; display: inline-flex; align-items: center; }
    .marquee__item::after { content: "✦"; margin-inline: 1.75rem; font-size: .8em; opacity: .75; }
    @keyframes slide { to { transform: translateX(-50%); } }
    .marquee:hover .marquee__track { animation-play-state: paused; }

    /* ---------- Objetivos ---------- */
    .goals { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; border-top: 1.5px solid var(--ink); }
    @media (min-width: 52rem) { .goals { grid-template-columns: repeat(2, 1fr); column-gap: clamp(2rem, 5vw, 5rem); } }
    .goal { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1.25rem; padding: 2rem 0; border-bottom: 1.5px solid var(--ink); }
    .goal__n { font-family: var(--font-label); font-weight: 600; font-size: .9rem; letter-spacing: .1em; color: var(--accent); padding-top: .35rem; }
    .goal h3 { font-size: var(--fs-h3); letter-spacing: -0.02em; font-weight: 800; line-height: 1.2; margin-bottom: .6rem; }
    .goal p { color: var(--ink-2); }
    .big-quote { margin-top: clamp(3rem, 2rem + 4vw, 5.5rem); font-size: clamp(1.9rem, 1.2rem + 3.4vw, 4rem); line-height: 1.05; letter-spacing: -0.035em; font-weight: 800; max-width: 22ch; text-wrap: balance; }

    /* ---------- Funciones ---------- */
    .feats { display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1.5px solid var(--ink); }
    @media (min-width: 40rem) { .feats { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 62rem) { .feats { grid-template-columns: repeat(3, 1fr); } }
    .feat { padding: 1.75rem 1.5rem 1.9rem 0; border-bottom: 1.5px solid var(--ink); }
    @media (min-width: 40rem) { .feat { padding-left: 1.5rem; border-left: 1.5px solid var(--ink); } .feat:nth-child(2n+1) { border-left: 0; padding-left: 0; } }
    @media (min-width: 62rem) { .feat:nth-child(2n+1) { border-left: 1.5px solid var(--ink); padding-left: 1.5rem; } .feat:nth-child(3n+1) { border-left: 0; padding-left: 0; } }
    .feat h3 { font-size: 1.125rem; letter-spacing: -0.015em; font-weight: 800; line-height: 1.25; margin-bottom: .5rem; display: flex; gap: .65rem; align-items: baseline; }
    .feat h3::before { content: ""; width: .55rem; height: .55rem; border-radius: 2px; background: var(--accent); flex: none; transform: translateY(-.1rem); }
    .feat p { color: var(--ink-2); font-size: .975rem; }

    /* ---------- Planes ---------- */
    .plans { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; align-items: stretch; }
    @media (min-width: 48rem) { .plans { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); } }
    .plan { position: relative; background: var(--paper); border: 1.5px solid var(--ink); border-radius: var(--radius); padding: 1.9rem 1.6rem; display: flex; flex-direction: column; gap: 1.1rem; }
    .plan--hl { background: var(--ink); color: var(--bg); box-shadow: 8px 8px 0 var(--accent); }
    .plan__badge { position: absolute; top: -.85rem; left: 1.4rem; background: var(--accent); color: #fff; font-family: var(--font-label); font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; padding: .35rem .8rem; border-radius: 999px; }
    .plan h3 { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; }
    .plan__for { font-size: .95rem; color: var(--ink-2); min-height: 3em; }
    .plan--hl .plan__for { color: var(--inv-fg-2); }
    .plan__price { display: flex; align-items: baseline; gap: .4rem; flex-wrap: wrap; }
    .plan__price b { font-size: clamp(2rem, 1.7rem + 1vw, 2.5rem); letter-spacing: -0.045em; line-height: 1; font-weight: 800; }
    .plan__price span { font-size: .9rem; color: var(--ink-2); font-weight: 600; }
    .plan--hl .plan__price span { color: var(--inv-fg-2); }
    .plan ul { display: grid; gap: .65rem; padding-top: 1.1rem; border-top: 1px solid var(--line); flex: 1; align-content: start; }
    .plan--hl ul { border-top-color: var(--inv-line); }
    .plan li { display: grid; grid-template-columns: auto 1fr; gap: .65rem; font-size: .975rem; }
    .plan li .check { margin-top: .28rem; }
    .plan--hl .check { background: #fff; }
    .plan--hl .check::after { border-color: var(--ink); }
    .plan--hl .btn--primary { background: #fff; border-color: #fff; color: var(--ink); }
    .plan--hl .btn--primary:hover { background: var(--accent-soft); border-color: var(--accent-soft); }
    .everyone { margin-top: 2.5rem; border: 1.5px dashed var(--ink); border-radius: var(--radius); padding: 1.5rem 1.6rem; display: grid; gap: 1rem; }
    @media (min-width: 52rem) { .everyone { grid-template-columns: 14rem 1fr; align-items: start; } }
    .everyone h3 { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.01em; }
    .everyone ul { display: grid; gap: .5rem 2rem; }
    @media (min-width: 40rem) { .everyone ul { grid-template-columns: repeat(2, 1fr); } }
    .everyone li { display: grid; grid-template-columns: auto 1fr; gap: .65rem; font-size: .975rem; }
    .everyone .check { margin-top: .28rem; }
    .fine { margin-top: 1.25rem; font-size: .875rem; color: var(--ink-2); }

    /* ---------- Roadmap ---------- */
    .road { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    @media (min-width: 40rem) { .road { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 62rem) { .road { grid-template-columns: repeat(3, 1fr); } }
    .road li { border: 1.5px solid var(--inv-line); border-radius: var(--radius); padding: 1.4rem 1.5rem; }
    .road li b { display: block; font-size: 1.05rem; font-weight: 800; letter-spacing: -0.01em; margin-bottom: .35rem; }
    .road li span { color: var(--inv-fg-2); font-size: .95rem; }
    .road__tag { display: inline-block !important; font-family: var(--font-label); font-size: .7rem !important; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #A9A3FF !important; margin-bottom: .6rem; }

    /* ---------- FAQ ---------- */
    .faq-wrap { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; align-items: start; }
    @media (min-width: 62rem) { .faq-wrap { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 4rem; } .faq-aside { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
    .faq-aside { background: var(--ink); color: var(--bg); border-radius: var(--radius); padding: 2rem; box-shadow: 8px 8px 0 var(--accent); }
    .faq-aside h3 { font-size: 1.5rem; letter-spacing: -0.025em; line-height: 1.15; font-weight: 800; }
    .faq-aside p { color: var(--inv-fg-2); margin: .9rem 0 1.5rem; }
    .faq-aside .btn--primary { background: #fff; border-color: #fff; color: var(--ink); }
    .faq-aside .btn--primary:hover { background: var(--accent-soft); border-color: var(--accent-soft); }
    .faq { border-top: 1.5px solid var(--ink); }
    .faq details { border-bottom: 1.5px solid var(--ink); }
    .faq summary { list-style: none; cursor: pointer; padding: 1.4rem 0; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; font-size: clamp(1.05rem, 1rem + .4vw, 1.3rem); font-weight: 700; letter-spacing: -0.015em; min-height: 3.5rem; }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after { content: "+"; font-size: 1.75rem; font-weight: 500; line-height: 1; color: var(--accent); transition: transform .25s var(--ease); flex: none; }
    .faq details[open] summary::after { transform: rotate(45deg); }
    .faq details > p { padding: 0 3rem 1.6rem 0; color: var(--ink-2); max-width: 44rem; }

    /* ---------- CTA final ---------- */
    .cta { text-align: left; }
    .cta h2 { font-size: clamp(2.4rem, 1.4rem + 5vw, 5.4rem); line-height: .98; letter-spacing: -0.045em; font-weight: 800; max-width: 16ch; text-wrap: balance; }
    .cta .lead { margin-top: 1.5rem; }
    .cta__row { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2.25rem; }

    /* ---------- Footer ---------- */
    .site-footer { background: var(--inv-bg); color: var(--inv-fg); border-top: 1px solid var(--inv-line); padding-block: 3rem 2.5rem; }
    .footer__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    @media (min-width: 52rem) { .footer__grid { grid-template-columns: 1.4fr 1fr 1fr; } }
    .site-footer h4 { font-family: var(--font-label); font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--inv-fg-2); margin: 0 0 1rem; }
    .site-footer li + li { margin-top: .55rem; }
    .site-footer a { text-decoration: none; }
    .site-footer a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .site-footer p { color: var(--inv-fg-2); font-size: .95rem; max-width: 30rem; margin-top: 1rem; }
    .footer__by { display: flex; align-items: center; gap: .7rem; }
    .footer__by img { height: 2.1rem; width: auto; }
    .footer__legal { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--inv-line); font-size: .85rem; color: var(--inv-fg-2); display: flex; flex-wrap: wrap; gap: .5rem 2rem; justify-content: space-between; }

    /* ---------- Aparición al hacer scroll ---------- */
    .js .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
    .js .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .js .reveal { opacity: 1; transform: none; transition: none; }
      .marquee__track, .chip, .hero h1 em::after, .tabpanel.is-in { animation: none !important; }
      .btn, .card, .arrow { transition: none; }
    }
  </style>
  <%# Capa de movimiento: animaciones y efectos. Es opcional y respeta "reducir movimiento" (ver el archivo). %>
  <link rel="stylesheet" href="/landing/movimiento.css">
</head>

<body>
  <div class="progreso" aria-hidden="true"></div>
  <a class="skip" href="#contenido">Saltar al contenido</a>

  <!-- ============ HEADER ============ -->
  <header class="site-header" data-header>
    <div class="container site-header__inner">
      <a class="brand" href="#inicio" aria-label="VEZZA Shop, ir al inicio">
        <img src="/vezza/marca.svg" alt="" width="36" height="30">
        <span>VEZZA <b>Shop</b></span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav" data-menu-toggle>Menú</button>
      <nav class="nav" id="nav" aria-label="Principal" data-nav>
        <ul class="nav__list">
          <li><a class="nav__link" href="#que-es">Qué es</a></li>
          <li><a class="nav__link" href="#como-funciona">Cómo funciona</a></li>
          <li><a class="nav__link" href="#capturas">Capturas</a></li>
          <li><a class="nav__link" href="#planes">Planes</a></li>
          <li><a class="nav__link" href="#preguntas">Preguntas</a></li>
        </ul>
        <div class="nav__actions">
          <a class="nav__login" href="/admin">Ingresar a mi panel</a>
          <a class="btn btn--primary" href="<%= pruebaHref || '#contacto' %>"<% if (!pruebaHref) { %> data-cta="Hola, quiero probar VEZZA Shop 7 días gratis."<% } %>>Probar gratis</a>
        </div>
      </nav>
    </div>
  </header>

  <main id="contenido">

    <!-- ============ HERO ============ -->
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="container hero__grid">
        <div>
          <p class="hero__tag"><i aria-hidden="true"></i>Plataforma de tiendas online · hecha en Argentina</p>
          <h1 id="hero-title" data-split>Tu tienda online, <em>sin vueltas.</em></h1>
          <p class="lead">VEZZA Shop te da una tienda lista para vender en tu propio link: catálogo, carrito, checkout y un panel para manejar tus pedidos, productos y diseño. Sin programar y sin comisión por venta.</p>
          <div class="hero__cta">
            <a class="btn btn--primary btn--lg" href="<%= pruebaHref || '#contacto' %>"<% if (!pruebaHref) { %> data-cta="Hola, quiero probar VEZZA Shop 7 días gratis."<% } %>>Probá 7 días gratis <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn--ghost btn--lg" href="#capturas">Ver el sistema por dentro</a>
          </div>
          <ul class="hero__checks">
            <li><span class="check" aria-hidden="true"></span>7 días de prueba</li>
            <li><span class="check" aria-hidden="true"></span>Cargá todo con un Excel</li>
            <li><span class="check" aria-hidden="true"></span>Cobrás directo en tu cuenta</li>
          </ul>
        </div>

        <div class="stage" data-tilt>
          <div class="chip chip--a" aria-hidden="true">
            <span class="chip__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
            <div><b>Pedido nuevo · #1</b><span>Camila R. · $ 49.995</span></div>
          </div>
          <figure class="win">
            <div class="win__bar"><i></i><i></i><i></i><span class="win__url">nube-studio.vezzashop.com</span></div>
            <img src="/landing/img/tienda-inicio.webp" width="1500" height="938" alt="Tienda online de ejemplo con logo, menú de categorías, banner de bienvenida y productos destacados" fetchpriority="high">
          </figure>
          <figure class="phone">
            <img src="/landing/img/tienda-movil.webp" width="520" height="1125" alt="La misma tienda vista en un celular" loading="eager">
          </figure>
          <div class="chip chip--b" aria-hidden="true">
            <span class="chip__icon" style="background:var(--ok)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>
            <div><b>Pago confirmado</b><span>Transferencia · 15% off</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CIFRAS ============ -->
    <section class="strip" aria-label="En números">
      <div class="container strip__grid">
        <div class="stat"><b data-count="10">10</b><span>fotos por producto, ordenables</span></div>
        <div class="stat"><b data-count="3">3</b><span>tipos de variante: talle, color, lo que necesites</span></div>
        <div class="stat"><b data-count="3">3</b><span>formas de pago: transferencia, efectivo y Mercado Pago</span></div>
        <div class="stat"><b data-count="0" data-from="30" data-suffix="%">0%</b><span>de comisión sobre tus ventas</span></div>
      </div>
    </section>

    <!-- ============ QUÉ ES / PARA QUÉ SIRVE ============ -->
    <section class="section" id="que-es" aria-labelledby="que-es-title">
      <div class="container">
        <div class="head reveal">
          <p class="eyebrow">Qué es y para qué sirve</p>
          <h2 class="h2" id="que-es-title">Todo lo que necesitás para vender online, <span class="accent">en un solo lugar.</span></h2>
          <p class="lead">VEZZA Shop es una plataforma de tiendas online. Cada negocio tiene su vidriera pública y su panel de administración: vos cargás lo que vendés, tus clientes compran desde el celular o la compu, y el pedido te llega ordenado.</p>
        </div>
        <div class="cards3">
          <article class="card reveal">
            <span class="card__n">01</span>
            <h3>Una vidriera que vende</h3>
            <p>Catálogo con buscador, filtros, variantes y fotos grandes. Vive en tu propio link, se ve perfecto en el celular y se comparte con vista previa en WhatsApp y redes.</p>
          </article>
          <article class="card reveal">
            <span class="card__n">02</span>
            <h3>Pedidos bajo control</h3>
            <p>Cada compra llega al panel con productos, datos del cliente, entrega y pago. Un botón por paso: pagado, enviado, entregado. Y el stock se descuenta solo.</p>
          </article>
          <article class="card reveal">
            <span class="card__n">03</span>
            <h3>Tu negocio, a tu manera</h3>
            <p>Logo, colores, tipografía, banners, envíos y formas de pago: lo configurás vos desde el panel, sin pedirle nada a nadie y sin tocar una línea de código.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ CÓMO FUNCIONA ============ -->
    <section class="section" id="como-funciona" aria-labelledby="como-title" style="background:var(--bg-2);border-block:1.5px solid var(--ink)">
      <div class="container">
        <div class="head reveal">
          <p class="eyebrow">Cómo funciona</p>
          <h2 class="h2" id="como-title">De la idea al primer pedido, <span class="accent">en cuatro pasos.</span></h2>
        </div>
        <ol class="steps">
          <li class="step reveal">
            <span class="step__n">1</span>
            <h3>Te damos tu tienda</h3>
            <p>Creamos tu tienda con su propio link, <strong>tunegocio.vezzashop.com</strong>, y tu acceso al panel. Listo para empezar el mismo día.</p>
          </li>
          <li class="step reveal">
            <span class="step__n">2</span>
            <h3>Cargás tus productos</h3>
            <p>Uno por uno, o todos juntos con una planilla de Excel (con las fotos incluidas). Si volvés a subirla, se actualiza y no se duplica nada.</p>
          </li>
          <li class="step reveal">
            <span class="step__n">3</span>
            <h3>Le das tu estilo</h3>
            <p>Subís el logo, elegís tu color, tipografía y banners, y configurás cómo entregás y cómo cobrás. Ves cómo queda antes de publicar.</p>
          </li>
          <li class="step reveal">
            <span class="step__n">4</span>
            <h3>Compartís el link y vendés</h3>
            <p>Lo mandás por WhatsApp, Instagram o donde quieras. Los pedidos llegan al panel y gestionás todo desde un mismo lugar.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ LA TIENDA (LO QUE VE EL CLIENTE) ============ -->
    <section class="section" id="tienda" aria-labelledby="tienda-title">
      <div class="container">
        <div class="split">
          <div class="split__text reveal">
            <p class="eyebrow">Lo que ve tu cliente</p>
            <h2 class="h2" id="tienda-title">Una tienda que da gusto comprar.</h2>
            <p class="lead" style="margin-top:1.25rem">Rápida, clara y pensada para el celular. Sin registrarse ni crear cuentas: elige, paga y listo.</p>
            <ul class="ticks">
              <li><span class="check" aria-hidden="true"></span><p><b>Buscador con sugerencias.</b> <span>Encuentra por nombre, marca o SKU, sin importar tildes ni mayúsculas.</span></p></li>
              <li><span class="check" aria-hidden="true"></span><p><b>Filtros y orden.</b> <span>Con stock, en oferta, por rango de precio. Se pueden compartir por link.</span></p></li>
              <li><span class="check" aria-hidden="true"></span><p><b>Variantes y galería.</b> <span>Selector de talle y color, fotos a pantalla completa y barra de compra fija en el celular.</span></p></li>
              <li><span class="check" aria-hidden="true"></span><p><b>Precios que convencen.</b> <span>Muestra el descuento por transferencia y las cuotas sin interés en cada producto.</span></p></li>
              <li><span class="check" aria-hidden="true"></span><p><b>WhatsApp a un toque.</b> <span>Botón flotante para que te consulten sin salir de la tienda.</span></p></li>
            </ul>
          </div>
          <div class="shopstage reveal">
            <figure class="win">
              <div class="win__bar"><i></i><i></i><i></i><span class="win__url">nube-studio.vezzashop.com/producto/remera-nube-oversize</span></div>
              <img src="/landing/img/tienda-producto.webp" width="1500" height="938" alt="Ficha de producto con selector de talle y color, precio con descuento, cuotas sin interés y botón Agregar al carrito" loading="lazy">
            </figure>
            <figure class="phone">
              <img src="/landing/img/tienda-producto-movil.webp" width="520" height="1125" alt="Ficha de producto en un celular" loading="lazy">
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CHECKOUT ============ -->
    <section class="section" style="padding-top:0" aria-labelledby="checkout-title">
      <div class="container">
        <div class="split split--rev">
          <div class="reveal">
            <figure class="win">
              <div class="win__bar"><i></i><i></i><i></i><span class="win__url">nube-studio.vezzashop.com/checkout</span></div>
              <img src="/landing/img/tienda-checkout.webp" width="1500" height="938" alt="Pantalla Finalizar compra con datos del cliente, formas de entrega y resumen del pedido con descuento" loading="lazy">
            </figure>
          </div>
          <div class="split__text reveal">
            <p class="eyebrow">Carrito y checkout</p>
            <h2 class="h2" id="checkout-title">Del carrito al pedido, en una sola pantalla.</h2>
            <p class="lead" style="margin-top:1.25rem">El cliente elige cómo recibir y cómo pagar, y ve el total exacto en vivo. Vos recibís el pedido completo, sin ida y vuelta de mensajes.</p>
            <ul class="ticks">
              <li><span class="check" aria-hidden="true"></span><p><b>Entrega a elección.</b> <span>Retiro en el local o envío a domicilio, con costo fijo, “gratis desde $X” o a coordinar.</span></p></li>
              <li><span class="check" aria-hidden="true"></span><p><b>Descuentos por forma de pago.</b> <span>Premiá la transferencia o el efectivo; el descuento se calcula solo.</span></p></li>
              <li><span class="check" aria-hidden="true"></span><p><b>Stock siempre real.</b> <span>Al confirmar se descuenta el stock; si alguien compró lo mismo antes, avisa y no crea nada.</span></p></li>
              <li><span class="check" aria-hidden="true"></span><p><b>Página del pedido.</b> <span>El cliente ve el estado, cómo pagar (alias con botón de copiar) y puede enviarte el comprobante por WhatsApp.</span></p></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SLOGANS ============ -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <div class="marquee__group">
          <span class="marquee__item">Tu tienda online, sin vueltas.</span>
          <span class="marquee__item">De la idea al primer pedido.</span>
          <span class="marquee__item">Menos vueltas, más ventas.</span>
          <span class="marquee__item">Tu marca, tu tienda, tus reglas.</span>
        </div>
        <div class="marquee__group">
          <span class="marquee__item">Tu tienda online, sin vueltas.</span>
          <span class="marquee__item">De la idea al primer pedido.</span>
          <span class="marquee__item">Menos vueltas, más ventas.</span>
          <span class="marquee__item">Tu marca, tu tienda, tus reglas.</span>
        </div>
      </div>
    </div>

    <!-- ============ CAPTURAS DEL PANEL ============ -->
    <section class="section inv" id="capturas" aria-labelledby="capturas-title">
      <div class="container">
        <div class="head reveal">
          <p class="eyebrow">Capturas del panel</p>
          <h2 class="h2" id="capturas-title">Tu negocio, <span class="accent">en un panel simple.</span></h2>
          <p class="lead">Así se ve por dentro. Nada de menús infinitos: cada sección hace una cosa y la hace bien. Funciona en la compu y en el celular, con modo claro y oscuro.</p>
        </div>

        <div role="tablist" aria-label="Secciones del panel" class="tabs" data-tabs>
          <button class="tab" role="tab" aria-selected="true" aria-controls="p-inicio" id="t-inicio">Inicio</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="p-pedidos" id="t-pedidos">Pedidos</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="p-productos" id="t-productos">Productos</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="p-excel" id="t-excel">Carga masiva</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="p-diseno" id="t-diseno">Diseño</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="p-pagos" id="t-pagos">Envíos y pagos</button>
