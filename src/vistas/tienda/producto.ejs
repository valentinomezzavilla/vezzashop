<%- include('cabecera', { titulo }) %>
<% const conCarrito = Boolean(ajustes.whatsapp) %>
<nav class="migas" aria-label="Estás en">
  <a href="/">Inicio</a>
  <% if (categoriasProducto.length) { %>
    <%- icono('derecha', { tamano: 14 }) %><a href="<%= urlCategoria(categoriasProducto[0]) %>"><%= categoriasProducto[0].nombre %></a>
  <% } %>
  <%- icono('derecha', { tamano: 14 }) %><span aria-current="page"><%= producto.nombre %></span>
</nav>

<article class="ficha" data-ficha data-nombre="<%= producto.nombre %>">
  <div class="ficha-galeria" data-galeria>
    <% if (fotos.length) { %>
      <div class="galeria-pista" data-galeria-pista tabindex="0" aria-label="Fotos de <%= producto.nombre %>" style="view-transition-name: foto-<%= producto.slug %>">
        <% fotos.forEach((url, n) => { %>
          <button type="button" class="galeria-boton" data-ampliar="<%= n %>" aria-label="Ver la foto <%= n + 1 %> en grande">
            <img class="galeria-foto" src="<%= url %>" alt="<%= producto.nombre %>, foto <%= n + 1 %> de <%= fotos.length %>"<%- n ? ' loading="lazy"' : ' fetchpriority="high"' %>>
          </button>
        <% }) %>
      </div>
      <span class="galeria-ampliar" aria-hidden="true"><%- icono('ampliar', { tamano: 18 }) %></span>
      <% if (fotos.length > 1) { %>
        <div class="galeria-miniaturas">
          <% fotos.forEach((url, n) => { %>
            <button type="button" class="galeria-miniatura" data-galeria-ir="<%= n %>" aria-label="Ver foto <%= n + 1 %>"<%- n === 0 ? ' aria-current="true"' : '' %>>
              <img src="<%= url %>" alt="" loading="lazy">
            </button>
          <% }) %>
        </div>
      <% } %>
    <% } else { %>
      <div class="foto foto-grande" aria-hidden="true" style="view-transition-name: foto-<%= producto.slug %>"><span><%= producto.nombre.charAt(0) %></span></div>
    <% } %>
  </div>

  <div class="ficha-datos">
    <header class="ficha-encabezado">
      <div class="ficha-encabezado-fila">
        <% if (producto.marca) { %><p class="marca-producto"><%= producto.marca %></p><% } else { %><span></span><% } %>
        <button class="boton-icono boton-compartir" type="button" data-compartir aria-label="Compartir este producto" title="Compartir"><%- icono('compartir', { tamano: 20 }) %></button>
      </div>
      <h1><%= producto.nombre %></h1>
    </header>

    <div class="bloque-precio">
      <p class="precio precio-grande">
        <span data-precio><%= inicial.precio %></span>
        <s data-precio-lista<%= inicial.precioLista ? '' : ' hidden' %>><%= inicial.precioLista %></s>
        <span class="etiqueta etiqueta-oferta" data-off<%= inicial.off ? '' : ' hidden' %>>-<span data-off-numero><%= inicial.off %></span>%</span>
      </p>
      <% if (inicial.cuota || inicial.transferencia) { %>
        <ul class="beneficios">
          <% if (inicial.cuota) { %>
            <li><%- icono('tarjeta', { tamano: 18 }) %><span><strong><%= ajustes.cuotasSinInteres %> cuotas sin interés</strong> de <span data-cuota><%= inicial.cuota %></span></span></li>
          <% } %>
          <% if (inicial.transferencia) { %>
            <li><%- icono('banco', { tamano: 18 }) %><span><strong data-transferencia><%= inicial.transferencia %></strong> con transferencia <span class="beneficio-off"><%= ajustes.descuentoTransferencia %>% off</span></span></li>
          <% } %>
        </ul>
      <% } %>
    </div>

    <% if (producto.atributos.length) { %>
      <div class="selector-variantes">
        <% producto.atributos.forEach((atributo, n) => { %>
          <fieldset class="opciones">
            <legend><%= atributo %>: <strong data-elegido="<%= n %>"><%= inicial.valores[n] %></strong></legend>
            <div class="opciones-lista">
              <% for (const valor of valoresPorAtributo[n]) { %>
                <label class="opcion">
                  <input type="radio" name="atributo-<%= n %>" value="<%= valor %>" data-atributo="<%= n %>"<%= valor === inicial.valores[n] ? ' checked' : '' %>>
                  <span><%= valor %></span>
                </label>
              <% } %>
            </div>
          </fieldset>
        <% }) %>
      </div>
    <% } %>

    <p class="stock <%= inicial.stock.clase %>" data-stock role="status"><%= inicial.stock.texto %></p>

    <% if (conCarrito) { %>
      <div class="comprar" data-comprar<%= inicial.hayStock ? '' : ' hidden' %>>
        <div class="cantidad-selector" data-cantidad-selector>
          <button class="cantidad-boton" type="button" data-cantidad-cambio="-1" aria-label="Una unidad menos"><%- icono('menos', { tamano: 18 }) %></button>
          <label class="visualmente-oculto" for="cantidad">Cantidad</label>
          <input id="cantidad" type="number" value="1" min="1" max="<%= inicial.disponibles %>" inputmode="numeric" data-cantidad>
          <button class="cantidad-boton" type="button" data-cantidad-cambio="1" aria-label="Una unidad más"><%- icono('mas', { tamano: 18 }) %></button>
        </div>
        <button class="boton boton-grande boton-agregar" type="button" data-agregar disabled>
          <%- icono('bolsa', { tamano: 20 }) %> Agregar al carrito
        </button>
      </div>
      <a class="boton boton-grande boton-bloque boton-contorno" href="<%= inicial.avisame %>" target="_blank" rel="noopener" data-avisame<%= inicial.hayStock ? ' hidden' : '' %>>
        <%- icono('campana', { tamano: 20 }) %> Avisame cuando haya stock
      </a>
      <a class="enlace-consultar" href="<%= inicial.whatsapp %>" target="_blank" rel="noopener" data-whatsapp>
        <%- icono('whatsapp', { tamano: 18 }) %> ¿Tenés dudas? Consultanos por WhatsApp
      </a>
    <% } %>

    <p class="sku">SKU <span data-sku><%= inicial.sku %></span></p>

    <% if (producto.descripcion) { %>
      <section class="descripcion">
        <h2>Descripción</h2>
        <p><%= producto.descripcion %></p>
      </section>
    <% } %>

    <% if (categoriasProducto.length) { %>
      <nav class="chips" aria-label="Categorías del producto">
        <% for (const categoria of categoriasProducto) { %>
          <a class="chip" href="<%= urlCategoria(categoria) %>"><%= categoria.nombre %></a>
        <% } %>
      </nav>
    <% } %>
  </div>
</article>

<% if (relacionados.length) { %>
  <section class="relacionados" aria-labelledby="titulo-relacionados">
    <h2 id="titulo-relacionados" class="titulo-seccion">También te puede gustar</h2>
    <ul class="grilla">
      <% for (const p of relacionados) { %><%- include('tarjeta-producto', { p }) %><% } %>
    </ul>
  </section>
<% } %>

<% if (conCarrito) { %>
  <%# En el celular, cuando el botón principal queda fuera de la pantalla, aparece esta barra. %>
  <div class="barra-compra" data-barra-compra aria-hidden="true">
    <div class="barra-compra-precio">
      <span class="barra-compra-nombre"><%= producto.nombre %></span>
      <strong data-barra-precio><%= inicial.precio %></strong>
    </div>
    <button class="boton" type="button" data-barra-agregar tabindex="-1"><%- icono('bolsa', { tamano: 18 }) %> Agregar</button>
  </div>
<% } %>

<% if (fotos.length) { %>
  <dialog class="visor" data-visor aria-label="Fotos de <%= producto.nombre %>">
    <button class="boton-icono visor-cerrar" type="button" data-cerrar aria-label="Cerrar"><%- icono('cerrar', { tamano: 24 }) %></button>
    <% if (fotos.length > 1) { %>
      <button class="boton-icono visor-anterior" type="button" data-visor-paso="-1" aria-label="Foto anterior"><%- icono('izquierda', { tamano: 26 }) %></button>
      <button class="boton-icono visor-siguiente" type="button" data-visor-paso="1" aria-label="Foto siguiente"><%- icono('derecha', { tamano: 26 }) %></button>
    <% } %>
    <img class="visor-foto" src="<%= fotos[0] %>" alt="" data-visor-foto>
    <p class="visor-contador" data-visor-contador aria-live="polite"></p>
    <script type="application/json" data-visor-fotos><%- JSON.stringify(fotos).replace(/</g, '\\u003c') %></script>
  </dialog>
<% } %>

<script type="application/json" id="variantes"><%- variantesJson %></script>
<script type="application/ld+json"><%- datosEstructurados %></script>
<%- include('pie', { sinWhatsappFlotante: Boolean(inicial.whatsapp) }) %>
