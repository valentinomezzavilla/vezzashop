</main>
<% const redes = [['Instagram', 'instagram', ajustes.instagram], ['Facebook', 'facebook', ajustes.facebook], ['TikTok', 'tiktok', ajustes.tiktok]].filter(([, , url]) => url) %>
<footer class="pie">
  <div class="pie-interior">
    <div class="pie-columna pie-marca">
      <a class="marca" href="/"><% if (urlLogo) { %><img class="logo" src="<%= urlLogo %>" alt="<%= tienda.nombre %>"><% } else { %><%= tienda.nombre %><% } %></a>
      <% if (ajustes.direccion) { %>
        <p class="pie-dato"><%- icono('ubicacion', { tamano: 18 }) %><span><%= ajustes.direccion %></span></p>
      <% } %>
      <% if (redes.length) { %>
        <div class="redes">
          <% for (const [red, nombreIcono, url] of redes) { %>
            <a class="red" href="<%= url %>" target="_blank" rel="noopener" aria-label="<%= red %> de <%= tienda.nombre %>"><%- icono(nombreIcono) %></a>
          <% } %>
        </div>
      <% } %>
    </div>

    <% if (categorias.length) { %>
      <nav class="pie-columna" aria-label="Categorías">
        <p class="pie-titulo">Categorías</p>
        <% for (const categoria of categorias) { %><a href="<%= urlCategoria(categoria) %>"><%= categoria.nombre %></a><% } %>
      </nav>
    <% } %>

    <% if (ajustes.emailContacto || ajustes.whatsapp) { %>
      <div class="pie-columna">
        <p class="pie-titulo">Contacto</p>
        <% if (ajustes.whatsapp) { %>
          <a class="pie-dato" href="https://wa.me/<%= ajustes.whatsapp %>" target="_blank" rel="noopener"><%- icono('whatsapp', { tamano: 18 }) %><span>WhatsApp</span></a>
        <% } %>
        <% if (ajustes.emailContacto) { %>
          <a class="pie-dato" href="mailto:<%= ajustes.emailContacto %>"><%- icono('mail', { tamano: 18 }) %><span><%= ajustes.emailContacto %></span></a>
        <% } %>
      </div>
    <% } %>
  </div>
  <p class="pie-copyright">© <%= new Date().getFullYear() %> <%= tienda.nombre %>. Todos los derechos reservados.</p>
</footer>
<%# En la ficha no va el botón flotante: ya está "Consultar por WhatsApp", con el producto en el mensaje. %>
<% if (ajustes.whatsapp && !locals.sinWhatsappFlotante) { %>
  <a class="boton-whatsapp" href="https://wa.me/<%= ajustes.whatsapp %>" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
    <%- icono('whatsapp', { tamano: 28 }) %>
  </a>
<% } %>

<%# Buscador: se abre desde la lupa de la cabecera. Sin JavaScript, la lupa lleva a /buscar. %>
<dialog class="panel-buscador" data-buscador aria-label="Buscar productos">
  <form class="buscador-formulario" method="get" action="/buscar" role="search">
    <%- icono('lupa', { tamano: 22 }) %>
    <label class="visualmente-oculto" for="buscador-q">Buscar productos</label>
    <input id="buscador-q" type="search" name="q" placeholder="¿Qué estás buscando?" autocomplete="off" data-buscador-entrada
           aria-controls="sugerencias" aria-autocomplete="list" enterkeyhint="search">
    <button class="boton-icono" type="button" data-cerrar aria-label="Cerrar el buscador"><%- icono('cerrar', { tamano: 22 }) %></button>
  </form>
  <div class="sugerencias" id="sugerencias" data-sugerencias aria-live="polite"></div>
</dialog>

<% if (checkoutActivo || ajustes.whatsapp) { %>
  <%# Carrito: vive en el navegador y los precios se piden frescos al abrirlo. Con checkout, sigue en /checkout
      (ahí se eligen la entrega y el pago); si la tienda todavía no lo configuró, el pedido se manda por WhatsApp. %>
  <% const descuentos = [ajustes.pagoTransferencia && ajustes.descuentoTransferencia && `${ajustes.descuentoTransferencia}% off con transferencia`,
                         ajustes.pagoEfectivo && ajustes.descuentoEfectivo && `${ajustes.descuentoEfectivo}% off en efectivo`].filter(Boolean) %>
  <dialog class="panel-carrito" data-carrito aria-labelledby="titulo-carrito"
          data-whatsapp="<%= ajustes.whatsapp %>" data-tienda="<%= tienda.nombre %>"<%- checkoutActivo ? ' data-checkout' : '' %>>
    <div class="carrito-cabecera">
      <h2 id="titulo-carrito">Tu carrito</h2>
      <button class="boton-icono" type="button" data-cerrar aria-label="Cerrar el carrito"><%- icono('cerrar', { tamano: 22 }) %></button>
    </div>
    <div class="carrito-cuerpo" data-carrito-items></div>
    <div class="carrito-pie" data-carrito-pie hidden>
      <dl class="carrito-totales">
        <div><dt>Subtotal</dt><dd data-carrito-total></dd></div>
      </dl>
      <% if (checkoutActivo) { %>
        <% if (descuentos.length) { %>
          <p class="carrito-beneficio"><%- icono('etiqueta', { tamano: 16 }) %><span><%= descuentos.join(' · ') %>. Lo elegís en el próximo paso.</span></p>
        <% } %>
        <a class="boton boton-grande boton-bloque" href="/checkout" data-carrito-checkout>Iniciar compra <%- icono('derecha', { tamano: 20 }) %></a>
        <p class="carrito-nota">En el próximo paso elegís cómo recibirlo y cómo pagar.</p>
      <% } else { %>
        <a class="boton boton-grande boton-bloque boton-whatsapp-ficha" href="#" target="_blank" rel="noopener" data-carrito-enviar>
          <%- icono('whatsapp', { tamano: 20 }) %> Enviar pedido por WhatsApp
        </a>
        <p class="carrito-nota">Te respondemos por WhatsApp para confirmar el stock, el envío y la forma de pago.</p>
      <% } %>
    </div>
  </dialog>
<% } %>
<p class="visualmente-oculto" role="status" aria-live="polite" data-anuncio></p>
</body>
</html>
