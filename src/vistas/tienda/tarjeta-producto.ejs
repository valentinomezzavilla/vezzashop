<% const extra = preciosExtra(p.precioDesde) %>
<% const off = porcentajeOff(p.precioLista, p.precioDesde) %>
<li>
  <a class="tarjeta-producto<%= p.stock === 0 ? ' agotado' : '' %>" href="/producto/<%= p.slug %>">
    <%# conTransicion: la foto "viaja" a la ficha al entrar. Solo en una grilla por página, porque el nombre tiene que ser único. %>
    <div class="foto<%= p.urlFoto ? ' con-foto' : '' %><%= p.urlFotoAlternativa ? ' con-alternativa' : '' %>"<%- locals.conTransicion ? ` style="view-transition-name: foto-${p.slug}"` : '' %>>
      <% if (p.urlFoto) { %>
        <%# 540 x 675: la caja es 4:5, así que el navegador reserva el lugar antes de que llegue la foto. %>
        <img src="<%= p.urlFoto %>" alt="<%= p.nombre %>" width="540" height="675"<%- locals.prioridad ? '' : ' loading="lazy"' %> decoding="async">
        <%# La foto de al pasar el mouse no se descarga hasta que hace falta (la carga tienda.js al primer hover o foco). %>
        <% if (p.urlFotoAlternativa) { %><img class="foto-alternativa" data-src="<%= p.urlFotoAlternativa %>" alt="" width="540" height="675" decoding="async"><% } %>
      <% } else { %>
        <span aria-hidden="true"><%= p.nombre.charAt(0) %></span>
      <% } %>
    </div>
    <div class="etiquetas">
      <% if (p.stock === 0) { %><span class="etiqueta etiqueta-sin-stock">Sin stock</span>
      <% } else if (off) { %><span class="etiqueta etiqueta-oferta">-<%= off %>%</span><% } %>
    </div>
    <div class="datos">
      <% if (p.marca) { %><span class="marca-producto"><%= p.marca %></span><% } %>
      <span class="nombre"><%= p.nombre %></span>
      <span class="precio">
        <% if (p.precioHasta !== p.precioDesde) { %><small>Desde</small><% } %>
        <%= formatearPrecio(p.precioDesde) %>
        <% if (off) { %><s><%= formatearPrecio(p.precioLista) %></s><% } %>
      </span>
      <% if (extra.transferencia) { %><span class="precio-transferencia"><%= extra.transferencia %> con transferencia</span><% } %>
    </div>
  </a>
</li>
