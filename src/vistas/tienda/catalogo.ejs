<%- include('cabecera', { titulo }) %>
<% if (banners.length) { %>
  <section class="carrusel" aria-roledescription="carrusel" aria-label="Novedades" data-carrusel>
    <div class="carrusel-pista" data-pista>
      <% banners.forEach((banner, n) => { %>
        <div class="carrusel-diapositiva" role="group" aria-roledescription="diapositiva" aria-label="<%= n + 1 %> de <%= banners.length %>">
          <% if (banner.enlace) { %><a href="<%= banner.enlace %>"><% } %>
          <picture>
            <% if (banner.urlImagenMovil) { %><source media="(max-width: 640px)" srcset="<%= banner.urlImagenMovil %>"><% } %>
            <img src="<%= banner.urlImagen %>" alt="<%= banner.textoAlternativo %>"<%- n > 0 ? ' loading="lazy"' : ' fetchpriority="high"' %>>
          </picture>
          <% if (banner.enlace) { %></a><% } %>
        </div>
      <% }) %>
    </div>
    <% if (banners.length > 1) { %>
      <button class="carrusel-flecha carrusel-anterior" type="button" data-anterior aria-label="Banner anterior"><%- icono('izquierda', { tamano: 22 }) %></button>
      <button class="carrusel-flecha carrusel-siguiente" type="button" data-siguiente aria-label="Banner siguiente"><%- icono('derecha', { tamano: 22 }) %></button>
      <div class="carrusel-puntos" data-puntos>
        <% banners.forEach((_, n) => { %>
          <button type="button" class="carrusel-punto" data-punto="<%= n %>" aria-label="Ir al banner <%= n + 1 %>"<%- n === 0 ? ' aria-current="true"' : '' %>></button>
        <% }) %>
      </div>
    <% } %>
  </section>
<% } %>

<% if (migas.length) { %>
  <nav class="migas" aria-label="Estás en">
    <a href="/">Inicio</a>
    <% for (const miga of migas.slice(0, -1)) { %>
      <%- icono('derecha', { tamano: 14 }) %><a href="<%= urlCategoria(miga) %>"><%= miga.nombre %></a>
    <% } %>
    <%- icono('derecha', { tamano: 14 }) %><span aria-current="page"><%= migas.at(-1).nombre %></span>
  </nav>
<% } %>

<% if (destacados.length) { %>
  <section class="seccion-destacados" aria-labelledby="titulo-destacados">
    <div class="encabezado-catalogo">
      <h2 id="titulo-destacados" class="titulo-seccion">Destacados</h2>
    </div>
    <ul class="grilla">
      <% for (const p of destacados) { %><%- include('tarjeta-producto', { p }) %><% } %>
    </ul>
  </section>
<% } %>

<% const busquedaPagina = locals.paginaBusqueda %>
<% if (busquedaPagina) { %>
  <form class="buscador-pagina" method="get" action="/buscar" role="search">
    <%- icono('lupa', { tamano: 22 }) %>
    <label class="visualmente-oculto" for="q-pagina">Buscar productos</label>
    <input id="q-pagina" type="search" name="q" value="<%= busqueda %>" placeholder="¿Qué estás buscando?" enterkeyhint="search"<%= busqueda ? '' : ' autofocus' %>>
    <button class="boton" type="submit">Buscar</button>
  </form>
<% } %>

<div class="encabezado-catalogo">
  <div>
    <h1><%= migas.length || busquedaPagina ? titulo : 'Todos los productos' %></h1>
    <% if (!busquedaPagina || busqueda) { %>
      <p class="cantidad" data-cantidad><%= total %> producto<%= total === 1 ? '' : 's' %></p>
    <% } %>
  </div>
  <% if (total > 0 || hayFiltros) { %>
    <div class="herramientas-catalogo">
      <details class="filtros" data-filtros>
        <summary class="boton boton-contorno boton-chico">
          <%- icono('filtros', { tamano: 16 }) %> Filtrar<% if (filtros.activos.length) { %> <span class="filtros-cuenta"><%= filtros.activos.length %></span><% } %>
        </summary>
        <form class="filtros-panel" method="get">
          <% if (busqueda) { %><input type="hidden" name="q" value="<%= busqueda %>"><% } %>
          <% if (orden) { %><input type="hidden" name="orden" value="<%= orden %>"><% } %>
          <fieldset>
            <legend>Mostrar</legend>
            <label class="casilla"><input type="checkbox" name="stock" value="1"<%= filtros.conStock ? ' checked' : '' %>> Solo con stock</label>
            <label class="casilla"><input type="checkbox" name="oferta" value="1"<%= filtros.enOferta ? ' checked' : '' %>> Solo en oferta</label>
          </fieldset>
          <fieldset>
            <legend>Precio</legend>
            <div class="rango-precio">
              <label><span class="visualmente-oculto">Precio mínimo</span>
                <span class="campo-pesos">$<input type="number" name="min" min="0" step="1" inputmode="numeric" value="<%= filtros.min %>" placeholder="<%= filtros.rango.minimo %>"></span>
              </label>
              <span aria-hidden="true">–</span>
              <label><span class="visualmente-oculto">Precio máximo</span>
                <span class="campo-pesos">$<input type="number" name="max" min="0" step="1" inputmode="numeric" value="<%= filtros.max %>" placeholder="<%= filtros.rango.maximo %>"></span>
              </label>
            </div>
          </fieldset>
          <div class="filtros-acciones">
            <button class="boton boton-chico" type="submit">Aplicar filtros</button>
            <% if (hayFiltros) { %><a class="enlace" href="<%= filtros.urlLimpiar %>">Limpiar</a><% } %>
          </div>
        </form>
      </details>
      <% if (total > 1) { %>
        <form class="ordenar" method="get" data-ordenar>
          <% if (busqueda) { %><input type="hidden" name="q" value="<%= busqueda %>"><% } %>
          <% for (const [clave, activo] of [['stock', filtros.conStock], ['oferta', filtros.enOferta]]) { %>
            <% if (activo) { %><input type="hidden" name="<%= clave %>" value="1"><% } %>
          <% } %>
          <% if (filtros.min !== '') { %><input type="hidden" name="min" value="<%= filtros.min %>"><% } %>
          <% if (filtros.max !== '') { %><input type="hidden" name="max" value="<%= filtros.max %>"><% } %>
          <label for="orden"><%- icono('ordenar', { tamano: 16 }) %><span>Ordenar</span></label>
          <select id="orden" name="orden">
            <% for (const [clave, opcion] of Object.entries(ordenes)) { %>
              <option value="<%= clave %>"<%= clave === orden ? ' selected' : '' %>><%= opcion.titulo %></option>
            <% } %>
          </select>
          <button class="boton boton-chico" type="submit" data-sin-js>Ordenar</button>
        </form>
      <% } %>
    </div>
  <% } %>
</div>

<% if (filtros.activos.length) { %>
  <div class="filtros-activos" aria-label="Filtros aplicados">
    <% for (const activo of filtros.activos) { %>
      <a class="chip chip-activo" href="<%= activo.url %>" aria-label="Quitar filtro: <%= activo.texto %>"><%= activo.texto %> <%- icono('cerrar', { tamano: 14 }) %></a>
    <% } %>
    <a class="enlace" href="<%= filtros.urlLimpiar %>">Limpiar todo</a>
  </div>
<% } %>

<% if (subcategorias.length) { %>
  <nav class="chips" aria-label="<%= migas.length ? 'Subcategorías' : 'Categorías' %>">
    <% for (const sub of subcategorias) { %>
      <a class="chip" href="<%= urlCategoria(sub) %>"><%= sub.nombre %></a>
    <% } %>
  </nav>
<% } %>

<% if (productos.length === 0) { %>
  <section class="estado-vacio">
    <div class="estado-vacio-icono" aria-hidden="true"><%- icono(busquedaPagina ? 'lupa' : 'paquete', { tamano: 28 }) %></div>
    <% if (busquedaPagina && !busqueda) { %>
      <h2>¿Qué estás buscando?</h2>
      <p>Escribí el nombre de un producto o elegí una categoría.</p>
    <% } else if (busquedaPagina) { %>
      <h2>No encontramos "<%= busqueda %>"</h2>
      <p><%= hayFiltros ? 'Probá sacando algún filtro, o buscá con otras palabras.' : 'Revisá cómo está escrito o probá con una palabra más general.' %></p>
    <% } else if (hayFiltros) { %>
      <h2>Ningún producto cumple esos filtros</h2>
      <p>Probá sacando alguno.</p>
      <a class="boton" href="<%= filtros.urlLimpiar %>">Ver todos</a>
    <% } else { %>
      <h2>Todavía no hay productos acá</h2>
      <p>Volvé pronto o mirá el resto de la tienda.</p>
      <% if (migas.length) { %><a class="boton" href="/">Ver todos los productos</a><% } %>
    <% } %>
    <% if (busquedaPagina && categorias.length) { %>
      <nav class="chips chips-centrados" aria-label="Categorías">
        <% for (const categoria of categorias) { %><a class="chip" href="<%= urlCategoria(categoria) %>"><%= categoria.nombre %></a><% } %>
      </nav>
    <% } %>
  </section>
<% } else { %>
  <ul class="grilla" data-grilla>
    <% for (const p of productos) { %><%- include('tarjeta-producto', { p, conTransicion: true }) %><% } %>
  </ul>
  <% if (urlSiguiente) { %>
    <div class="paginacion">
      <p class="cantidad" data-mostrando>Viendo <%= mostrados %> de <%= total %></p>
      <a class="boton boton-contorno" href="<%= urlSiguiente %>" data-ver-mas>Ver más productos</a>
    </div>
  <% } %>
<% } %>
<%- include('pie') %>
