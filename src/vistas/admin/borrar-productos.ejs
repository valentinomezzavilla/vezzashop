<%- include('../parciales/cabecera', { titulo: 'Borrar productos' }) %>
<% const cantidad = productos.length; const textoCantidad = `${cantidad} producto${cantidad === 1 ? '' : 's'}`; %>
<header class="encabezado">
  <div>
    <h1>Borrar <%= textoCantidad %></h1>
    <p class="texto-suave">Revisá la lista antes de confirmar: no se puede deshacer.</p>
  </div>
</header>

<section class="tarjeta zona-peligro">
  <ul class="lista-borrar">
    <% for (const p of productos) { %>
      <li>
        <% if (p.urlFoto) { %><img class="miniatura" src="<%= p.urlFoto %>" alt="" loading="lazy">
        <% } else { %><span class="miniatura" aria-hidden="true"><%- icono('imagen', { tamano: 16 }) %></span><% } %>
        <span class="celda-producto-textos">
          <span class="celda-producto-nombre"><%= p.nombre %></span>
          <span class="ayuda"><%= p.variantes %> variante<%= p.variantes === 1 ? '' : 's' %></span>
        </span>
      </li>
    <% } %>
  </ul>
  <p class="aviso aviso-error"><%- icono('alerta', { tamano: 18 }) %><span>También se borran sus fotos y variantes. Los pedidos ya hechos no cambian.</span></p>
  <form method="post" action="/admin/productos/borrar-varios/confirmar" class="acciones" data-un-solo-envio>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="volver" value="<%= volver %>">
    <% for (const p of productos) { %><input type="hidden" name="ids" value="<%= p.id %>"><% } %>
    <button class="boton boton-peligro" type="submit"><%- icono('basura', { tamano: 18 }) %> Sí, borrar <%= textoCantidad %></button>
    <a class="boton boton-fantasma" href="<%= volver %>">Cancelar</a>
  </form>
</section>
<%- include('../parciales/pie') %>
