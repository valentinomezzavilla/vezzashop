<%- include('../parciales/cabecera', { titulo: 'Ingresar' }) %>
<section class="tarjeta centrada angosta">
  <h1>Ingresá a tu panel</h1>
  <% if (error) { %><p class="aviso aviso-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/admin/ingresar" class="formulario">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Email
      <input type="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
    </label>
    <label>Clave
      <input type="password" name="clave" autocomplete="current-password" required>
    </label>
    <button class="boton" type="submit">Ingresar</button>
  </form>
</section>
<%- include('../parciales/pie') %>
