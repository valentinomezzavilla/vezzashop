<%# La pestaña Dashboard: las estadísticas del negocio. Se elige el período y el panel (Resumen, Ventas, Pedidos, Clientes, Productos o Stock);
    cada panel calcula solo lo suyo (src/dashboard.js). Datos: dashboard (lo que arma prepararVista() de src/dashboard-vista.js) y limites (el plan). %>
<%- include('../parciales/cabecera', { titulo: 'Dashboard' }) %>
<% const { periodo, panel, enlaces, hoy } = dashboard %>
<header class="encabezado">
  <div>
    <h1>Dashboard</h1>
    <p class="texto-suave">
      <% if (panel === 'stock') { %>El stock de hoy
      <% } else { %><%= periodo.texto %><% if (periodo.anterior) { %> · comparado con <%= periodo.anterior.titulo %><% } %>
      <% } %>
    </p>
  </div>
</header>

<div class="barra-herramientas dashboard-controles">
  <nav class="pestanias dashboard-paneles" aria-label="Secciones del dashboard">
    <% for (const p of enlaces.paneles) { %><a href="<%= p.url %>"<%- p.activo ? ' class="activa" aria-current="page"' : '' %>><%= p.titulo %></a><% } %>
  </nav>
  <% if (panel !== 'stock') { %>
    <nav class="pestanias dashboard-periodos" aria-label="Período">
      <% for (const p of enlaces.periodos) { %><a href="<%= p.url %>"<%- p.activo ? ' class="activa" aria-current="true"' : '' %>><%= p.titulo %></a><% } %>
    </nav>
  <% } %>
</div>

<% if (panel !== 'stock') { %>
  <details class="dashboard-rango"<%= periodo.clave === 'rango' || periodo.error || dashboard.valoresRango.desde ? ' open' : '' %>>
    <summary><%- icono('reloj', { tamano: 15 }) %> Elegir fechas</summary>
    <form class="dashboard-rango-form" method="get" action="/admin/dashboard">
      <input type="hidden" name="panel" value="<%= panel %>">
      <input type="hidden" name="periodo" value="rango">
      <div class="campo">
        <label for="dashboard-desde">Desde</label>
        <input id="dashboard-desde" type="date" name="desde" value="<%= periodo.clave === 'rango' ? periodo.desde : dashboard.valoresRango.desde %>" max="<%= hoy %>" required>
      </div>
      <div class="campo">
        <label for="dashboard-hasta">Hasta</label>
        <input id="dashboard-hasta" type="date" name="hasta" value="<%= periodo.clave === 'rango' ? periodo.hasta : dashboard.valoresRango.hasta %>" max="<%= hoy %>" required>
      </div>
      <button class="boton boton-secundario" type="submit">Ver estas fechas</button>
    </form>
    <% if (periodo.error) { %><p class="error-campo" role="alert"><%= periodo.error %></p><% } %>
  </details>
<% } %>

<div class="dashboard-contenido">
  <%- include(`../parciales/dashboard/${panel}`, { d: dashboard, limites }) %>
</div>

<p class="ayuda dashboard-nota">
  Las ventas son los pedidos pagados, enviados y entregados: los nuevos (sin pago confirmado) y los cancelados no suman.
  Los días y las horas son de Argentina.
</p>
<%- include('../parciales/pie') %>
