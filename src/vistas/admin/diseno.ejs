<%- include('../parciales/cabecera', { titulo: 'Diseño' }) %>
<%
  // Atributos de accesibilidad de un campo: lo marca como inválido y lo asocia a su ayuda y su error.
  const accesibilidad = (campo, conAyuda = true) => {
    const describe = [conAyuda && `ayuda-${campo}`, errores[campo] && `error-${campo}`].filter(Boolean).join(' ');
    return (errores[campo] ? ' aria-invalid="true"' : '') + (describe ? ` aria-describedby="${describe}"` : '');
  };
  const error = (campo) => include('../parciales/error-campo', { mensaje: errores[campo], id: `error-${campo}` });
  // Si el formulario volvió con errores, `valores` es lo que se envió (puede faltar algún campo); si no, lo guardado.
  const volvio = valores._csrf !== undefined;
  const valor = (campo, porDefecto = '') => valores[campo] ?? porDefecto;
  const esColor = (texto) => /^#[0-9a-f]{6}$/i.test(texto ?? '');
  const franjaPropia = volvio ? Boolean(valores.franjaColorPropio) : esColor(valores.colorFranja);
  const colorFranja = esColor(valores.colorFranja) ? valores.colorFranja : valores.colorPrincipal;
  const fuenteActual = Object.hasOwn(opcionesFuente, valor('fuente')) ? valor('fuente') : 'sistema';
  const esquinasActual = Object.hasOwn(opcionesEsquinas, valor('esquinas')) ? valor('esquinas') : 'redondeadas';
  const tarjetasActual = Object.hasOwn(opcionesTarjetas, valor('tarjetas')) ? valor('tarjetas') : 'normales';
  const sinStockActual = Object.hasOwn(opcionesSinStock, valor('sinStock')) ? valor('sinStock') : 'mostrar';
  const categoriasPortadaActual = Object.hasOwn(opcionesCategoriasPortada, valor('categoriasPortada')) ? valor('categoriasPortada') : 'pocas';
  // Para mostrar cada tipografía con su propia letra en las tarjetas de arriba (se piden juntas, en un solo pedido).
  const hojaFuentes = 'https://fonts.googleapis.com/css2?' + Object.values(opcionesFuente).filter((f) => f.google).map((f) => `family=${f.google.split(':')[0]}:wght@600`).join('&') + '&display=swap';
%>
<link rel="stylesheet" href="<%= hojaFuentes %>">
<header class="encabezado">
  <div>
    <h1>Diseño de tu tienda</h1>
    <p class="texto-suave">Cambiá cómo se ve tu tienda. Los cambios se ven apenas guardás.</p>
  </div>
  <% if (urlMiTienda) { %>
    <a class="boton boton-secundario" href="<%= urlMiTienda %>" target="_blank" rel="noopener"><%- icono('externo', { tamano: 16 }) %> Ver cómo queda</a>
  <% } %>
</header>

<%- include('diseno-plan-resumen', { plan }) %>

<% if (Object.keys(errores).length) { %>
  <p class="aviso aviso-error" role="alert"><%- icono('alerta', { tamano: 18 }) %><span>Hay campos para revisar. Todavía no se guardó nada.</span></p>
<% } %>

<form method="post" action="/admin/diseno" enctype="multipart/form-data" class="ajustes" id="form-diseno">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <section class="ajuste">
    <div class="ajuste-intro">
      <h2>Identidad</h2>
      <p class="texto-suave">El logo y el color hacen que la tienda se vea como tu marca.</p>
    </div>
    <div class="tarjeta ajuste-campos">
      <div class="campo">
        <span class="etiqueta">Logo</span>
        <div class="selector-imagen">
          <div class="selector-imagen-vista" data-vista="logo">
            <% if (urlLogo) { %><img src="<%= urlLogo %>" alt="Logo actual"><% } else { %><%- icono('imagen', { tamano: 24 }) %><% } %>
          </div>
          <div class="selector-imagen-acciones">
            <label class="boton boton-secundario boton-chico">
              <%- icono('subir', { tamano: 16 }) %> <%= urlLogo ? 'Cambiar logo' : 'Subir logo' %>
              <input class="visualmente-oculto" type="file" name="logo" accept="image/png,image/jpeg,image/webp"
                     data-previsualizar="logo"<%- accesibilidad('logo') %>>
            </label>
            <% if (urlLogo) { %>
              <label class="casilla"><input type="checkbox" name="quitarLogo" value="1"> Quitar el logo</label>
            <% } %>
          </div>
        </div>
        <span class="ayuda" id="ayuda-logo">PNG, JPG o WEBP de hasta <%= megasImagen %> MB, mejor con fondo transparente. Si no subís uno, se muestra el nombre de la tienda.</span>
        <%- error('logo') %>
      </div>

      <div class="campo">
        <label for="colorPrincipal">Color principal</label>
        <div class="selector-color">
          <input id="colorPrincipal" type="color" name="colorPrincipal" value="<%= valores.colorPrincipal %>" data-color<%- accesibilidad('colorPrincipal') %>>
          <code data-color-hex><%= valores.colorPrincipal %></code>
        </div>
        <span class="ayuda" id="ayuda-colorPrincipal">Se usa en los botones y, si no elegís otro, en la franja de anuncios. El color del texto se ajusta solo para que se lea bien.</span>
        <%- error('colorPrincipal') %>
      </div>

      <div class="campo">
        <label for="franjaTexto">Franja de anuncios</label>
        <input id="franjaTexto" type="text" name="franjaTexto" value="<%= valores.franjaTexto %>" maxlength="200" data-franja
               placeholder="Envío gratis desde $100.000 / 15% off con transferencia"<%- accesibilidad('franjaTexto') %>>
        <span class="ayuda" id="ayuda-franjaTexto">Aparece arriba de todo, en todas las páginas. Dejala vacía para no mostrarla.</span>
        <%- error('franjaTexto') %>
      </div>

      <div class="campo">
        <label for="franjaEnlace">Link de la franja <span class="opcional">(opcional)</span></label>
        <input id="franjaEnlace" type="text" name="franjaEnlace" value="<%= valor('franjaEnlace') %>" placeholder="/categoria/ofertas"<%- accesibilidad('franjaEnlace') %>>
        <span class="ayuda" id="ayuda-franjaEnlace">Si lo completás, el anuncio se puede tocar y lleva a una página de tu tienda o a un link completo.</span>
        <%- error('franjaEnlace') %>
      </div>

      <div class="campo">
        <span class="etiqueta">Color de la franja</span>
        <label class="casilla"><input type="checkbox" name="franjaColorPropio" value="1" data-franja-propio<%= franjaPropia ? ' checked' : '' %>> Usar otro color en la franja</label>
        <div class="selector-color">
          <input id="colorFranja" type="color" name="colorFranja" value="<%= colorFranja %>" data-color-franja aria-label="Color de la franja"<%- accesibilidad('colorFranja', false) %>>
          <code data-color-franja-hex><%= colorFranja %></code>
        </div>
        <span class="ayuda">Si no lo marcás, la franja usa el color principal.</span>
        <%- error('colorFranja') %>
      </div>

      <div class="vista-previa" data-vista-previa aria-hidden="true">
        <span class="vista-previa-titulo">Vista previa</span>
        <div class="vista-previa-franja" data-vista-franja><%= valores.franjaTexto || 'Tu anuncio va acá' %></div>
        <%# El logo con el mismo tamaño máximo que tiene en la cabecera de la tienda. %>
        <div class="vista-previa-cabecera" data-vista-cabecera>
          <% if (urlLogo) { %><img class="vista-previa-logo" src="<%= urlLogo %>" alt=""><% } else { %><span class="vista-previa-nombre"><%= nombreTienda %></span><% } %>
        </div>
        <div class="vista-previa-cuerpo">
          <span class="vista-previa-boton">Botón de ejemplo</span>
        </div>
      </div>
    </div>
  </section>

  <section class="ajuste" id="estilo">
    <div class="ajuste-intro">
      <h2>Estilo</h2>
      <p class="texto-suave">La letra y las esquinas de los botones y las tarjetas. Combinadas con tu color, le dan personalidad a la tienda.</p>
    </div>
    <div class="tarjeta ajuste-campos">
      <fieldset class="tipos-entrega tipos-varios">
        <legend class="etiqueta">Tipografía</legend>
        <% for (const [clave, fuente] of Object.entries(opcionesFuente)) { %>
          <label class="opcion-tipo">
            <input type="radio" name="fuente" value="<%= clave %>"<%= fuenteActual === clave ? ' checked' : '' %>>
            <span class="muestra-fuente" style="font-family: <%= fuente.titulos ?? 'inherit' %>"><strong><%= fuente.titulo %></strong></span>
            <span class="ayuda"><%= fuente.ayuda %></span>
          </label>
        <% } %>
        <%- error('fuente') %>
      </fieldset>

      <fieldset class="tipos-entrega tipos-tres">
        <legend class="etiqueta">Esquinas</legend>
        <% for (const [clave, forma] of Object.entries(opcionesEsquinas)) { %>
          <% const r = forma.radios ?? { grande: 20, boton: 999 } %>
          <label class="opcion-tipo">
            <input type="radio" name="esquinas" value="<%= clave %>"<%= esquinasActual === clave ? ' checked' : '' %>>
            <span><span class="muestra-esquinas" aria-hidden="true"><i style="border-radius: <%= r.grande %>px"></i><b style="border-radius: <%= r.boton %>px"></b></span> <strong><%= forma.titulo %></strong></span>
            <span class="ayuda"><%= forma.ayuda %></span>
          </label>
        <% } %>
        <%- error('esquinas') %>
      </fieldset>
    </div>
  </section>

  <section class="ajuste" id="cabecera">
    <%
      const estiloActual = Object.hasOwn(estilosMenu, valores.menuEstilo) ? valores.menuEstilo : 'barra';
      const tamanoActual = Object.hasOwn(tamanosLogo, valores.logoTamano) ? valores.logoTamano : 'mediano';
      // Si el formulario ya se envió (y volvió con errores), se respeta lo que se había marcado; si no, lo guardado.
      const marcadas = valores.menuCategoriasEnviado === '1'
        ? new Set([].concat(valores.menuCategorias ?? []).map(Number))
        : new Set(categoriasMenu.filter((c) => c.enMenu).map((c) => c.id));
    %>
    <div class="ajuste-intro">
      <h2>Cabecera y menú</h2>
      <p class="texto-suave">Cómo se ve la parte de arriba de tu tienda: el menú de categorías y el tamaño del logo.</p>
    </div>
    <div class="tarjeta ajuste-campos">
      <div class="vista-previa vista-previa-cab" data-vista-menu data-menu="<%= estiloActual %>" data-logo="<%= tamanoActual %>" aria-hidden="true">
        <span class="vista-previa-titulo">Vista previa</span>
        <div class="vista-previa-cabecera">
          <div class="vista-previa-marca">
            <% if (urlLogo) { %><img class="vista-previa-logo" src="<%= urlLogo %>" alt=""><% } else { %><span class="vista-previa-nombre"><%= nombreTienda %></span><% } %>
          </div>
          <div class="vista-previa-menu" data-menu-lista></div>
          <span class="vista-previa-iconos"><%- icono('lupa', { tamano: 18 }) %><%- icono('bolsa', { tamano: 18 }) %><span class="vista-previa-hamburguesa"><%- icono('menu', { tamano: 18 }) %></span></span>
        </div>
      </div>

      <fieldset class="tipos-entrega">
        <legend class="etiqueta">Estilo del menú</legend>
        <% for (const [clave, estilo] of Object.entries(estilosMenu)) { %>
          <label class="opcion-tipo">
            <input type="radio" name="menuEstilo" value="<%= clave %>"<%= estiloActual === clave ? ' checked' : '' %>>
            <span><%- icono(clave === 'barra' ? 'filtros' : 'menu', { tamano: 20 }) %> <strong><%= estilo.titulo %></strong></span>
            <span class="ayuda"><%= estilo.ayuda %></span>
          </label>
        <% } %>
        <%- error('menuEstilo') %>
      </fieldset>

      <fieldset class="tipos-entrega tipos-tres">
        <legend class="etiqueta">Tamaño del logo</legend>
        <% for (const [clave, tamano] of Object.entries(tamanosLogo)) { %>
          <label class="opcion-tipo">
            <input type="radio" name="logoTamano" value="<%= clave %>"<%= tamanoActual === clave ? ' checked' : '' %>>
            <span><strong><%= tamano.titulo %></strong></span>
            <span class="ayuda"><%= tamano.alto %> px de alto</span>
          </label>
        <% } %>
        <%- error('logoTamano') %>
      </fieldset>

      <fieldset class="campo">
        <legend class="etiqueta">Categorías en el menú</legend>
        <input type="hidden" name="menuCategoriasEnviado" value="1">
        <% if (categoriasMenu.length === 0) { %>
          <p class="estado-vacio-chico"><%- icono('carpeta', { tamano: 18 }) %> Todavía no creaste categorías. Cuando las tengas, elegís acá cuáles aparecen en el menú.</p>
        <% } else { %>
          <div class="lista-categorias">
            <% for (const categoria of categoriasMenu) { %>
              <label class="casilla">
                <input type="checkbox" name="menuCategorias" value="<%= categoria.id %>" data-categoria-menu data-nombre="<%= categoria.nombre %>"<%= marcadas.has(categoria.id) ? ' checked' : '' %>>
                <%= categoria.nombre %><% if (categoria.hijas.length) { %> <span class="ayuda">· con <%= categoria.hijas.length %> subcategoría<%= categoria.hijas.length === 1 ? '' : 's' %></span><% } %>
              </label>
            <% } %>
          </div>
          <span class="ayuda">Las subcategorías aparecen adentro de su categoría. Una categoría sin productos visibles no se muestra, la elijas o no. <a class="enlace-chico" href="/admin/categorias">Administrar categorías</a></span>
        <% } %>
      </fieldset>
    </div>
  </section>

  <section class="ajuste">
    <div class="ajuste-intro">
      <h2>Catálogo</h2>
      <p class="texto-suave">En qué orden aparecen los productos cuando alguien entra a la tienda.</p>
    </div>
    <div class="tarjeta ajuste-campos">
      <div class="campo">
        <label for="ordenCatalogo">Orden de los productos</label>
        <select id="ordenCatalogo" name="ordenCatalogo"<%- accesibilidad('ordenCatalogo') %>>
          <% for (const [clave, opcion] of Object.entries(ordenes)) { %>
            <option value="<%= clave %>"<%= clave === valores.ordenCatalogo ? ' selected' : '' %>><%= opcion.titulo %></option>
          <% } %>
        </select>
        <span class="ayuda" id="ayuda-ordenCatalogo">Tus clientes lo pueden cambiar desde la tienda.</span>
        <%- error('ordenCatalogo') %>
      </div>

      <fieldset class="tipos-entrega tipos-tres">
        <legend class="etiqueta">Tamaño de las tarjetas de producto</legend>
        <% for (const [clave, tarjeta] of Object.entries(opcionesTarjetas)) { %>
          <label class="opcion-tipo">
            <input type="radio" name="tarjetas" value="<%= clave %>"<%= tarjetasActual === clave ? ' checked' : '' %>>
            <span><strong><%= tarjeta.titulo %></strong></span>
            <span class="ayuda"><%= tarjeta.ayuda %></span>
          </label>
        <% } %>
        <span class="ayuda campo-ancho">En el celular se ven siempre de a dos.</span>
        <%- error('tarjetas') %>
      </fieldset>

      <fieldset class="tipos-entrega tipos-tres">
        <legend class="etiqueta">Productos sin stock</legend>
        <% for (const [clave, opcion] of Object.entries(opcionesSinStock)) { %>
          <label class="opcion-tipo">
            <input type="radio" name="sinStock" value="<%= clave %>"<%= sinStockActual === clave ? ' checked' : '' %>>
            <span><strong><%= opcion.titulo %></strong></span>
            <span class="ayuda"><%= opcion.ayuda %></span>
          </label>
        <% } %>
        <%- error('sinStock') %>
      </fieldset>

      <fieldset class="tipos-entrega tipos-tres">
        <legend class="etiqueta">Categorías en la portada</legend>
        <% for (const [clave, opcion] of Object.entries(opcionesCategoriasPortada)) { %>
          <label class="opcion-tipo">
            <input type="radio" name="categoriasPortada" value="<%= clave %>"<%= categoriasPortadaActual === clave ? ' checked' : '' %>>
            <span><strong><%= opcion.titulo %></strong></span>
            <span class="ayuda"><%= opcion.ayuda %></span>
          </label>
        <% } %>
        <%- error('categoriasPortada') %>
      </fieldset>

      <div class="ajuste-campos-dos">
        <div class="campo">
          <label for="tituloCatalogo">Título del catálogo</label>
          <input id="tituloCatalogo" type="text" name="tituloCatalogo" value="<%= valor('tituloCatalogo', 'Todos los productos') %>" maxlength="60" placeholder="Todos los productos"<%- accesibilidad('tituloCatalogo') %>>
          <span class="ayuda" id="ayuda-tituloCatalogo">Arriba de la lista de productos de la portada.</span>
          <%- error('tituloCatalogo') %>
        </div>
        <div class="campo">
          <label for="tituloDestacados">Título de los destacados</label>
          <input id="tituloDestacados" type="text" name="tituloDestacados" value="<%= valor('tituloDestacados', 'Destacados') %>" maxlength="60" placeholder="Destacados"<%- accesibilidad('tituloDestacados') %>>
          <span class="ayuda" id="ayuda-tituloDestacados">Por ejemplo "Lo más vendido" o "Nuestra selección".</span>
          <%- error('tituloDestacados') %>
        </div>
      </div>
    </div>
  </section>

  <%# Colores, portada, tarjetas, logo, pie y diseño a medida: dependen del nivel de diseño del plan (ver diseno-plan.ejs). %>
  <%- include('diseno-plan', { plan }) %>

  <section class="ajuste" id="sobre">
    <div class="ajuste-intro">
      <h2>Sobre la tienda</h2>
      <p class="texto-suave">Un par de líneas para presentarte. Salen en el pie y como descripción cuando compartís el link o te busca Google.</p>
    </div>
    <div class="tarjeta ajuste-campos">
      <div class="campo">
        <label for="descripcion">Descripción</label>
        <textarea id="descripcion" name="descripcion" rows="3" maxlength="300" placeholder="Somos una tienda familiar de Córdoba. Envíos a todo el país y atención por WhatsApp."<%- accesibilidad('descripcion') %>><%= valor('descripcion') %></textarea>
        <span class="ayuda" id="ayuda-descripcion">Hasta 300 caracteres. Dejala vacía para no mostrarla.</span>
        <%- error('descripcion') %>
      </div>
      <div class="campo">
        <label for="notaPie">Nota al pie <span class="opcional">(opcional)</span></label>
        <input id="notaPie" type="text" name="notaPie" value="<%= valor('notaPie') %>" maxlength="300" placeholder="Precios con IVA incluido. Cambios dentro de los 30 días."<%- accesibilidad('notaPie') %>>
        <span class="ayuda" id="ayuda-notaPie">Va abajo de todo, antes de los derechos reservados: condiciones de compra, cambios, aclaraciones.</span>
        <%- error('notaPie') %>
      </div>
    </div>
  </section>

  <section class="ajuste">
    <div class="ajuste-intro">
      <h2>Contacto y redes</h2>
      <p class="texto-suave">Aparecen en el pie de la tienda. Con WhatsApp, además, se muestra un botón flotante en todas las páginas.</p>
    </div>
    <div class="tarjeta ajuste-campos ajuste-campos-dos">
      <div class="campo">
        <label for="whatsapp">WhatsApp</label>
        <input id="whatsapp" type="tel" name="whatsapp" value="<%= valores.whatsapp %>" placeholder="5493511234567"
               autocomplete="tel"<%- accesibilidad('whatsapp') %>>
        <span class="ayuda" id="ayuda-whatsapp">Con código de país y de área, sin el 0 ni el 15.</span>
        <%- error('whatsapp') %>
      </div>
      <div class="campo">
        <label for="emailContacto">Email de contacto</label>
        <input id="emailContacto" type="email" name="emailContacto" value="<%= valores.emailContacto %>"
               placeholder="hola@mitienda.com" autocomplete="email"<%- accesibilidad('emailContacto', false) %>>
        <%- error('emailContacto') %>
      </div>
      <div class="campo">
        <label for="instagram">Instagram</label>
        <input id="instagram" type="text" name="instagram" value="<%= valores.instagram %>" placeholder="@mitienda"<%- accesibilidad('instagram', false) %>>
        <%- error('instagram') %>
      </div>
      <div class="campo">
        <label for="facebook">Facebook</label>
        <input id="facebook" type="text" name="facebook" value="<%= valores.facebook %>" placeholder="mitienda"<%- accesibilidad('facebook', false) %>>
        <%- error('facebook') %>
      </div>
      <div class="campo">
        <label for="tiktok">TikTok</label>
        <input id="tiktok" type="text" name="tiktok" value="<%= valores.tiktok %>" placeholder="@mitienda"<%- accesibilidad('tiktok', false) %>>
        <%- error('tiktok') %>
      </div>
      <div class="campo campo-ancho">
        <label for="direccion">Dirección</label>
        <input id="direccion" type="text" name="direccion" value="<%= valores.direccion %>" maxlength="300"
               placeholder="Av. Siempre Viva 742, Córdoba"<%- accesibilidad('direccion') %>>
        <span class="ayuda" id="ayuda-direccion">Si tenés varios locales, separalos con "/".</span>
        <%- error('direccion') %>
      </div>
      <div class="campo">
        <label for="direccionMapa">Link del mapa <span class="opcional">(opcional)</span></label>
        <input id="direccionMapa" type="text" name="direccionMapa" value="<%= valor('direccionMapa') %>" placeholder="https://maps.app.goo.gl/..."<%- accesibilidad('direccionMapa') %>>
        <span class="ayuda" id="ayuda-direccionMapa">Agrega "Cómo llegar" junto a la dirección. Copiá el link desde Google Maps, en Compartir.</span>
        <%- error('direccionMapa') %>
      </div>
      <div class="campo">
        <label for="horarios">Horario de atención <span class="opcional">(opcional)</span></label>
        <input id="horarios" type="text" name="horarios" value="<%= valor('horarios') %>" maxlength="150" placeholder="Lunes a viernes de 9 a 18 hs"<%- accesibilidad('horarios') %>>
        <%- error('horarios') %>
      </div>
    </div>
  </section>

  <div class="barra-guardar">
    <span class="ayuda" data-sin-guardar hidden><%- icono('alerta', { tamano: 16 }) %> Tenés cambios sin guardar</span>
    <button class="boton" type="submit"><%- icono('check', { tamano: 18 }) %> Guardar cambios</button>
  </div>
</form>

<section class="ajuste" id="banners">
  <div class="ajuste-intro">
    <h2>Banners de bienvenida</h2>
    <p class="texto-suave">Las imágenes grandes del carrusel de la portada, en este orden. <%= maxBanners === 0 ? 'Tu plan no incluye banners.' : `Hasta ${maxBanners}.` %></p>
    <p class="ayuda">Tamaño recomendado: 1600 × 600 px para computadora y 800 × 1000 px para celular.</p>
  </div>
  <div class="tarjeta ajuste-campos">
    <% if (aviso && aviso.seccion === 'banners') { %>
      <p class="aviso aviso-<%= aviso.tipo %>" role="status"><%- icono(aviso.tipo === 'ok' ? 'check' : 'alerta', { tamano: 18 }) %><span><%= aviso.texto %></span></p>
    <% } %>

    <% if (banners.length) { %>
      <ol class="lista-banners">
        <% banners.forEach((banner, n) => { %>
          <li class="banner">
            <span class="banner-numero" aria-hidden="true"><%= n + 1 %></span>
            <img src="<%= banner.urlImagen %>" alt="">
            <div class="banner-datos">
              <strong><%= banner.textoAlternativo || `Banner ${n + 1}` %></strong>
              <span class="ayuda"><%= banner.enlace ? `Lleva a ${banner.enlace}` : 'Sin link' %><%= banner.imagenMovil ? ' · con imagen para celular' : '' %></span>
            </div>
            <div class="banner-acciones">
              <% for (const [accion, nombreIcono, etiqueta, deshabilitado] of [
                   ['subir', 'arriba', 'Subir', n === 0],
                   ['bajar', 'abajo', 'Bajar', n === banners.length - 1],
                   ['borrar', 'basura', 'Borrar', false]]) { %>
                <form method="post" action="/admin/diseno/banners/<%= banner.id %>/<%= accion %>">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="boton-icono<%= accion === 'borrar' ? ' boton-icono-peligro' : '' %>" type="submit"
                          aria-label="<%= etiqueta %> banner <%= n + 1 %>" title="<%= etiqueta %>"<%= deshabilitado ? ' disabled' : '' %>>
                    <%- icono(nombreIcono, { tamano: 18 }) %>
                  </button>
                </form>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ol>
    <% } else { %>
      <p class="estado-vacio-chico"><%- icono('imagen', { tamano: 20 }) %> Todavía no hay banners. La portada muestra directamente los productos.</p>
    <% } %>

    <% if (banners.length < maxBanners) { %>
      <%# Con JavaScript, al elegir la imagen aparece el recortador (ver admin.js): se acomoda cada recorte y se ve cómo queda en la
          tienda. Sin JavaScript el formulario sigue andando: la imagen se guarda entera. %>
      <% const { computadora, celular } = proporcionBanner %>
      <form method="post" action="/admin/diseno/banners" enctype="multipart/form-data" class="agregar-banner">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <h3>Agregar un banner</h3>
        <p class="ayuda">En tu tienda el banner se ve <strong>panorámico en la computadora</strong> y <strong>cuadrado en el celular</strong>. Al elegir la imagen vas a poder acomodar cada recorte y ver cómo queda antes de agregarlo.</p>
        <div class="ajuste-campos-dos">
          <div class="campo">
            <span class="etiqueta">Imagen del banner</span>
            <label class="zona-archivo zona-archivo-chica" data-vista="banner">
              <%- icono('imagen', { tamano: 24 }) %>
              <span class="zona-archivo-texto" data-nombre-archivo>Elegir imagen</span>
              <input class="visualmente-oculto" type="file" name="imagen" accept="image/png,image/jpeg,image/webp" required data-previsualizar="banner">
            </label>
            <span class="ayuda">Idealmente de <%= computadora.pixelesIdeales[0] %> × <%= computadora.pixelesIdeales[1] %> px. JPG, PNG o WEBP.</span>
          </div>
          <div class="campo">
            <span class="etiqueta">Otra imagen para celular <span class="opcional">(opcional)</span></span>
            <label class="zona-archivo zona-archivo-chica" data-vista="banner-movil">
              <%- icono('imagen', { tamano: 24 }) %>
              <span class="zona-archivo-texto" data-nombre-archivo>Elegir imagen</span>
              <input class="visualmente-oculto" type="file" name="imagenMovil" accept="image/png,image/jpeg,image/webp" data-previsualizar="banner-movil">
            </label>
            <span class="ayuda">Si no la subís, el celular usa la misma imagen con su propio recorte.</span>
          </div>
        </div>

        <div class="recortador" data-recortador hidden>
          <div class="recortador-cabecera">
            <h4>Así se va a ver en tu tienda</h4>
            <p class="ayuda" id="ayuda-recorte">Arrastrá la imagen para moverla y usá el zoom para acercarla. Con el teclado, las flechas la mueven y + / − cambian el zoom.
              Los puntitos de abajo y las flechas de los costados se muestran sobre el banner: evitá poner textos ahí.</p>
          </div>
          <div class="recortador-marcos">
            <% for (const [clave, titulo, p, tipo] of [['computadora', 'En computadora', computadora, 'ancho'], ['celular', 'En celular', celular, 'cuadrado']]) { %>
              <figure class="recorte recorte-<%= tipo %>" data-recorte="<%= clave %>" data-proporcion="<%= p.ancho %>:<%= p.alto %>" data-ideal="<%= p.pixelesIdeales[0] %>"
                      style="--proporcion: <%= p.ancho %> / <%= p.alto %>; --ancho-real: <%= clave === 'celular' ? 390 : 1240 %>">
                <figcaption>
                  <strong><%= titulo %></strong>
                  <span class="ayuda" data-origen><%= clave === 'celular' ? 'Con la misma imagen' : '' %></span>
                </figcaption>
                <div class="recorte-marco" data-marco tabindex="0" role="group" aria-label="Recorte para <%= clave === 'celular' ? 'celular' : 'computadora' %>" aria-describedby="ayuda-recorte">
                  <img alt="" draggable="false">
                  <span class="recorte-puntos" aria-hidden="true"><i class="activo"></i><i></i><i></i></span>
                  <% if (clave === 'computadora') { %>
                    <span class="recorte-flecha recorte-flecha-izq" aria-hidden="true"><%- icono('izquierda', { tamano: 18 }) %></span>
                    <span class="recorte-flecha recorte-flecha-der" aria-hidden="true"><%- icono('derecha', { tamano: 18 }) %></span>
                  <% } %>
                </div>
                <div class="recorte-controles">
                  <button class="boton-icono" type="button" data-alejar aria-label="Alejar"><%- icono('menos', { tamano: 18 }) %></button>
                  <input type="range" min="100" max="300" step="1" value="100" data-zoom aria-label="Zoom del recorte para <%= clave === 'celular' ? 'celular' : 'computadora' %>">
                  <button class="boton-icono" type="button" data-acercar aria-label="Acercar"><%- icono('mas', { tamano: 18 }) %></button>
                  <button class="boton boton-fantasma boton-chico" type="button" data-centrar>Restablecer</button>
                </div>
                <p class="recorte-aviso" data-aviso aria-live="polite"></p>
                <input type="hidden" name="recorte<%= clave === 'celular' ? 'Celular' : 'Computadora' %>" data-valor>
              </figure>
            <% } %>
          </div>
        </div>

        <div class="ajuste-campos-dos">
          <div class="campo">
            <label for="enlace">Link <span class="opcional">(opcional)</span></label>
            <input id="enlace" type="text" name="enlace" placeholder="/categoria/ofertas" aria-describedby="ayuda-enlace">
            <span class="ayuda" id="ayuda-enlace">A dónde lleva al tocarlo: una página de tu tienda o un link completo.</span>
          </div>
          <div class="campo">
            <label for="textoAlternativo">Descripción de la imagen</label>
            <input id="textoAlternativo" type="text" name="textoAlternativo" maxlength="150" placeholder="Nueva colección de invierno"
                   aria-describedby="ayuda-textoAlternativo">
            <span class="ayuda" id="ayuda-textoAlternativo">La leen los buscadores y las personas que usan lectores de pantalla.</span>
          </div>
        </div>
        <div class="acciones"><button class="boton" type="submit"><%- icono('subir', { tamano: 18 }) %> Agregar banner</button></div>
      </form>
    <% } %>
  </div>
</section>
<%- include('../parciales/pie') %>
