<%- include('../parciales/cabecera', { titulo: 'Pedidos' }) %>
<header class="encabezado">
  <div>
    <h1>Pedidos</h1>
    <p class="texto-suave"><%= cuentas.abiertos %> por atender · <%= cuentas.todos %> en total</p>
  </div>
</header>

<% if (!checkoutActivo) { %>
  <p class="aviso aviso-info" role="status">
    <%- icono('alerta', { tamano: 18 }) %>
    <span>Tu tienda todavía no recibe pedidos online: los clientes te mandan el carrito por WhatsApp.
      <a href="/admin/pagos">Configurá cómo entregás y cómo cobrás</a> para que puedan comprar desde la tienda.</span>
  </p>
<% } %>

<% if (cuentas.todos === 0) { %>
  <section class="tarjeta estado-vacio">
    <div class="estado-vacio-icono" aria-hidden="true"><%- icono('recibo', { tamano: 28 }) %></div>
    <h2>Todavía no hay pedidos</h2>
    <p class="texto-suave">Cuando alguien compre en tu tienda, el pedido aparece acá con sus datos, la forma de entrega y cómo va a pagar.</p>
    <% if (urlMiTienda) { %><a class="boton boton-secundario" href="<%= urlMiTienda %>" target="_blank" rel="noopener"><%- icono('externo', { tamano: 16 }) %> Ver mi tienda</a><% } %>
  </section>
<% } else { %>
  <div class="barra-herramientas">
    <nav class="pestanias" aria-label="Filtrar pedidos">
      <% for (const [clave, opcion] of Object.entries(filtros)) { %>
        <a href="/admin/pedidos?filtro=<%= clave %><%= busqueda ? `&q=${encodeURIComponent(busqueda)}` : '' %>"<%- clave === filtro ? ' class="activa" aria-current="page"' : '' %>>
          <%= opcion.titulo %> <span class="pestania-cuenta"><%= cuentas[clave] %></span>
        </a>
      <% } %>
    </nav>
    <form class="buscador" method="get" action="/admin/pedidos" role="search">
      <input type="hidden" name="filtro" value="<%= filtro %>">
      <label class="visualmente-oculto" for="q">Buscar pedidos</label>
      <%- icono('lupa', { tamano: 18 }) %>
      <input id="q" type="search" name="q" value="<%= busqueda %>" placeholder="Número, nombre, teléfono o email">
    </form>
  </div>

  <% if (pedidos.length === 0) { %>
    <section class="tarjeta estado-vacio">
      <div class="estado-vacio-icono" aria-hidden="true"><%- icono('lupa', { tamano: 28 }) %></div>
      <h2>No hay pedidos acá</h2>
      <p class="texto-suave"><%= busqueda ? `No encontramos "${busqueda}"` : 'No hay pedidos en este filtro' %>.</p>
      <a class="boton boton-secundario" href="/admin/pedidos?filtro=todos">Ver todos</a>
    </section>
  <% } else { %>
    <div class="tabla-contenedor">
      <table class="tabla tabla-pedidos">
        <thead>
          <tr>
            <th scope="col">Pedido</th>
            <th scope="col">Cliente</th>
            <th scope="col">Entrega y pago</th>
            <th scope="col" class="numero">Total</th>
            <th scope="col">Estado</th>
          </tr>
        </thead>
        <tbody>
        <% for (const p of pedidos) { %>
          <tr>
            <td>
              <a class="celda-pedido" href="/admin/pedidos/<%= p.id %>">#<%= p.numero %></a>
              <span class="ayuda celda-nota"><%= p.fecha %></span>
            </td>
            <td>
              <span class="celda-fila"><%= p.cliente.nombre %></span>
              <span class="ayuda celda-nota"><%= p.unidades %> producto<%= p.unidades === 1 ? '' : 's' %></span>
            </td>
            <td>
              <span class="celda-fila"><%= p.entrega.nombre %></span>
              <span class="ayuda celda-nota"><%= p.tituloPago %></span>
            </td>
            <td class="numero precio-celda"><%= formatearPrecio(p.total) %><% if (p.envio === null) { %><span class="ayuda celda-nota">+ envío</span><% } %></td>
            <td><span class="pastilla pastilla-<%= p.estado %>"><%= p.tituloEstado %></span></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <p class="ayuda pie-tabla"><%= pedidos.length %> pedido<%= pedidos.length === 1 ? '' : 's' %><%= busqueda ? ` que coinciden con "${busqueda}"` : '' %><%= pedidos.length === 200 ? ' (se muestran los 200 más nuevos)' : '' %></p>
  <% } %>
<% } %>
<%- include('../parciales/pie') %>
