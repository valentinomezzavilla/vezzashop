<%- include('../parciales/cabecera', { titulo: 'Productos' }) %>
<%
  // La misma lista con otro filtro (o con el de ahora): conserva la búsqueda, el orden y la categoría elegidos.
  const parametrosLista = (nuevoFiltro) => [
    `filtro=${nuevoFiltro}`,
    busqueda && `q=${encodeURIComponent(busqueda)}`,
    orden !== 'nombre' && `orden=${orden}`,
    categoria !== null && `categoria=${categoria}`,
  ].filter(Boolean).join('&');
  const volver = `/admin/productos?${parametrosLista(filtro)}`;
%>
<header class="encabezado">
  <div>
    <h1>Productos</h1>
    <p class="texto-suave"><%= cuentas.todos %> producto<%= cuentas.todos === 1 ? '' : 's' %> · <%= cuentas.visibles %> visible<%= cuentas.visibles === 1 ? '' : 's' %> en la tienda<% if (limites.maxProductos !== null) { %> · tu plan permite hasta <%= limites.maxProductos %><% } %></p>
  </div>
  <div class="acciones">
    <a class="boton boton-secundario" href="/admin/importar"><%- icono('subir', { tamano: 18 }) %> Carga masiva</a>
    <a class="boton" href="/admin/productos/nuevo"><%- icono('mas', { tamano: 18 }) %> Nuevo producto</a>
  </div>
</header>

<% if (cuentas.todos === 0) { %>
  <section class="tarjeta estado-vacio">
    <div class="estado-vacio-icono" aria-hidden="true"><%- icono('paquete', { tamano: 28 }) %></div>
    <h2>Todavía no cargaste productos</h2>
    <p class="texto-suave">Cargalos de a uno, o muchos de una vez con una planilla de Excel.</p>
    <div class="acciones">
      <a class="boton" href="/admin/productos/nuevo"><%- icono('mas', { tamano: 18 }) %> Nuevo producto</a>
      <a class="boton boton-secundario" href="/admin/importar">Carga masiva</a>
    </div>
  </section>
<% } else { %>
  <div class="barra-herramientas">
    <nav class="pestanias" aria-label="Filtrar productos">
      <% for (const [clave, opcion] of Object.entries(filtros)) { %>
        <a href="/admin/productos?<%= parametrosLista(clave) %>"<%- clave === filtro ? ' class="activa" aria-current="page"' : '' %>>
          <%= opcion.titulo %> <span class="pestania-cuenta"><%= cuentas[clave] %></span>
        </a>
      <% } %>
    </nav>
    <form class="buscador" method="get" action="/admin/productos" role="search">
      <input type="hidden" name="filtro" value="<%= filtro %>">
      <% if (orden !== 'nombre') { %><input type="hidden" name="orden" value="<%= orden %>"><% } %>
      <% if (categoria !== null) { %><input type="hidden" name="categoria" value="<%= categoria %>"><% } %>
      <label class="visualmente-oculto" for="q">Buscar productos</label>
      <%- icono('lupa', { tamano: 18 }) %>
      <input id="q" type="search" name="q" value="<%= busqueda %>" placeholder="Buscar producto o SKU">
    </form>
  </div>

  <%# Orden y categoría: se aplican al elegirlos (con JavaScript); sin él, con el botón. %>
  <div class="filtros-lista">
    <form method="get" action="/admin/productos" class="filtros-lista-campos">
      <input type="hidden" name="filtro" value="<%= filtro %>">
      <% if (busqueda) { %><input type="hidden" name="q" value="<%= busqueda %>"><% } %>
      <div class="campo-inline">
        <label for="orden-productos">Ordenar por</label>
        <select id="orden-productos" name="orden" data-autoenviar>
          <% for (const [clave, opcion] of Object.entries(ordenes)) { %>
            <option value="<%= clave %>"<%= clave === orden ? ' selected' : '' %>><%= opcion.titulo %></option>
          <% } %>
        </select>
      </div>
      <% if (categoriasLista.length) { %>
        <div class="campo-inline">
          <label for="categoria-productos">Categoría</label>
          <select id="categoria-productos" name="categoria" data-autoenviar>
            <option value="">Todas</option>
            <option value="sin"<%= categoria === 'sin' ? ' selected' : '' %>>Sin categoría</option>
            <% for (const c of categoriasLista) { %>
              <option value="<%= c.id %>"<%= categoria === c.id ? ' selected' : '' %>><%= '  '.repeat(c.nivel) %><%= c.nombre %></option>
            <% } %>
          </select>
        </div>
      <% } %>
      <button class="boton boton-secundario boton-chico" type="submit" data-sin-js>Aplicar</button>
    </form>
    <% if (sinStockVisibles > 0) { %>
      <details class="confirmar confirmar-neutro filtros-lista-accion">
        <summary class="boton boton-secundario boton-chico"><%- icono('ojo-tachado', { tamano: 16 }) %> <%= sinStockVisibles === 1 ? 'Ocultar el que no tiene stock' : `Ocultar los ${sinStockVisibles} sin stock` %></summary>
        <form method="post" action="/admin/productos/ocultar-sin-stock" class="confirmar-cuerpo">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="volver" value="<%= volver %>">
          <p><%= sinStockVisibles === 1 ? 'Se oculta de la tienda el producto visible que no tiene stock.' : `Se ocultan de la tienda los ${sinStockVisibles} productos visibles que no tienen stock.` %> Cuando vuelva a haber, lo mostrás de nuevo desde acá.</p>
          <button class="boton boton-chico" type="submit">Sí, ocultarlos</button>
        </form>
      </details>
    <% } %>
  </div>

  <% if (productos.length === 0) { %>
    <section class="tarjeta estado-vacio">
      <div class="estado-vacio-icono" aria-hidden="true"><%- icono('lupa', { tamano: 28 }) %></div>
      <h2>No hay productos que coincidan</h2>
      <p class="texto-suave"><%= busqueda ? `No encontramos "${busqueda}"` : 'No hay productos en este filtro' %>.</p>
      <a class="boton boton-secundario" href="/admin/productos">Ver todos</a>
    </section>
  <% } else { %>
    <%# Las casillas de cada fila se asocian a este formulario con el atributo form: las filas ya tienen sus propios formularios. %>
    <form id="borrar-varios" class="barra-seleccion" method="post" action="/admin/productos/acciones-varias" data-barra-seleccion>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="volver" value="<%= volver %>">
      <span class="barra-seleccion-cuenta"><strong data-cuenta-seleccion>0</strong> seleccionados</span>
      <label class="visualmente-oculto" for="accion-varios">Qué hacer con los productos seleccionados</label>
      <select id="accion-varios" name="accion" required>
        <option value="">Elegí una acción…</option>
        <option value="mostrar">Mostrar en la tienda</option>
        <option value="ocultar">Ocultar de la tienda</option>
        <option value="destacar">Destacar en la portada</option>
        <option value="quitar-destacado">Quitar de destacados</option>
        <option value="borrar">Borrar…</option>
      </select>
      <button class="boton boton-chico" type="submit">Aplicar</button>
    </form>
    <%# Fuera de la tabla: en el celular el encabezado de la tabla se oculta. Sin JavaScript no sirve, así que lo muestra admin.js. %>
    <label class="seleccionar-todos" hidden data-control-seleccion>
      <input type="checkbox" data-seleccionar-todos> Seleccionar todos
    </label>
    <div class="tabla-contenedor">
      <table class="tabla tabla-productos">
        <thead>
          <tr>
            <th scope="col" class="celda-seleccion"><span class="visualmente-oculto">Seleccionar</span></th>
            <th scope="col">Producto</th>
            <th scope="col">Precio</th>
            <th scope="col" class="numero">Stock</th>
            <th scope="col">Estado</th>
            <th scope="col"><span class="visualmente-oculto">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
        <% for (const p of productos) { %>
          <tr>
            <td class="celda-seleccion">
              <input type="checkbox" name="ids" value="<%= p.id %>" form="borrar-varios" aria-label="Seleccionar <%= p.nombre %>">
            </td>
            <td class="celda-producto-td">
              <a class="celda-producto" href="/admin/productos/<%= p.id %>">
                <% if (p.urlFoto) { %><img class="miniatura" src="<%= p.urlFoto %>" alt="" loading="lazy">
                <% } else { %><span class="miniatura" aria-hidden="true"><%- icono('imagen', { tamano: 16 }) %></span><% } %>
                <span class="celda-producto-textos">
                  <span class="celda-producto-nombre"><%= p.nombre %><% if (p.destacado) { %> <span class="destacado-marca" title="Destacado"><%- icono('estrella', { tamano: 14 }) %><span class="visualmente-oculto">(destacado)</span></span><% } %></span>
                  <span class="ayuda"><%= p.variantes %> variante<%= p.variantes === 1 ? '' : 's' %><%= p.marca ? ` · ${p.marca}` : '' %></span>
                </span>
              </a>
            </td>
            <td class="precio-celda" data-etiqueta="Precio">
              <%= formatearPrecio(p.precioMinimo) %><% if (p.precioMaximo !== p.precioMinimo) { %> – <%= formatearPrecio(p.precioMaximo) %><% } %>
            </td>
            <td class="numero" data-etiqueta="Stock">
              <% if (p.stock === 0) { %><span class="sin-stock">Sin stock</span>
              <% } else { %><%= p.stock %><% if (p.variantesSinStock) { %><span class="ayuda celda-nota"><%= p.variantesSinStock %> sin stock</span><% } %><% } %>
            </td>
            <td data-etiqueta="Estado"><span class="pastilla<%= p.visible ? ' pastilla-ok' : '' %>"><%= p.visible ? 'Visible' : 'Oculto' %></span></td>
            <td class="celda-acciones">
              <div class="acciones-fila">
                <form method="post" action="/admin/productos/<%= p.id %>/destacado">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="valor" value="<%= p.destacado ? '0' : '1' %>">
                  <input type="hidden" name="volver" value="<%= volver %>">
                  <button class="boton-icono<%= p.destacado ? ' boton-icono-activo' : '' %>" type="submit"
                          aria-label="<%= p.destacado ? 'Quitar de destacados' : 'Destacar' %> <%= p.nombre %>" title="<%= p.destacado ? 'Quitar de destacados' : 'Destacar en la portada' %>">
                    <%- icono('estrella', { tamano: 18 }) %>
                  </button>
                </form>
                <form method="post" action="/admin/productos/<%= p.id %>/visible">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="valor" value="<%= p.visible ? '0' : '1' %>">
                  <input type="hidden" name="volver" value="<%= volver %>">
                  <button class="boton-icono" type="submit" aria-label="<%= p.visible ? 'Ocultar' : 'Mostrar' %> <%= p.nombre %>"
                          title="<%= p.visible ? 'Ocultar de la tienda' : 'Mostrar en la tienda' %>">
                    <%- icono(p.visible ? 'ojo-tachado' : 'ojo', { tamano: 18 }) %>
                  </button>
                </form>
                <a class="boton-icono" href="/admin/productos/<%= p.id %>" aria-label="Editar <%= p.nombre %>" title="Editar"><%- icono('lapiz', { tamano: 18 }) %></a>
              </div>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <p class="ayuda pie-tabla"><%= productos.length %> de <%= cuentas[filtro] %> producto<%= cuentas[filtro] === 1 ? '' : 's' %><%= busqueda ? ` que coinciden con "${busqueda}"` : '' %></p>
  <% } %>
<% } %>
<%- include('../parciales/pie') %>
