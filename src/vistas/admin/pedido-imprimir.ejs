<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Remito del pedido #<%= pedido.numero %> · <%= tienda.nombre %></title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body { margin: 0; padding: 1.5rem; font: 14px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #111; background: #fff; }
    .hoja { max-width: 760px; margin: 0 auto; }
    .barra { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
    .boton { padding: .55rem 1rem; border: 0; border-radius: 8px; background: #111; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
    .volver { color: #444; font-size: .9rem; }
    h1 { margin: 0; font-size: 1.5rem; }
    h2 { margin: 1.4rem 0 .4rem; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: #555; }
    .cabecera { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding-bottom: .9rem; border-bottom: 2px solid #111; }
    .cabecera p { margin: .15rem 0 0; color: #444; }
    .destino { padding: .8rem 1rem; border: 2px solid #111; border-radius: 10px; }
    .destino strong { display: block; font-size: 1.25rem; }
    .destino .linea { font-size: 1.1rem; margin-top: .15rem; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: .45rem .5rem; text-align: left; border-bottom: 1px solid #ccc; vertical-align: top; }
    th { font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: #555; }
    .num { text-align: right; white-space: nowrap; }
    .chico { color: #555; font-size: .85rem; }
    .totales { margin-top: .75rem; margin-left: auto; width: 16rem; }
    .totales div { display: flex; justify-content: space-between; padding: .15rem 0; }
    .totales .final { border-top: 2px solid #111; margin-top: .3rem; padding-top: .35rem; font-size: 1.15rem; font-weight: 700; }
    .nota { padding: .6rem .8rem; border: 1px dashed #888; border-radius: 8px; }
    .casillas { display: flex; gap: 1.5rem; margin-top: 1.2rem; color: #333; }
    .casillas span::before { content: "☐ "; }
    @page { margin: 12mm; }
    @media print { body { padding: 0; } .barra { display: none; } }
  </style>
</head>
<body>
<div class="hoja">
  <div class="barra">
    <a class="volver" href="/admin/pedidos/<%= pedido.id %>">← Volver al pedido</a>
    <button class="boton" type="button" onclick="window.print()">Imprimir</button>
  </div>

  <div class="cabecera">
    <div>
      <h1><%= tienda.nombre %></h1>
      <p>Pedido <strong>#<%= pedido.numero %></strong> · <%= fecha %></p>
    </div>
    <div style="text-align: right">
      <p><strong><%= tituloEstado %></strong></p>
      <p><%= pedido.tituloPago %></p>
    </div>
  </div>

  <h2><%= pedido.entrega.tipo === 'domicilio' ? 'Enviar a' : 'Lo retira' %></h2>
  <div class="destino">
    <strong><%= pedido.cliente.nombre %></strong>
    <% if (pedido.entrega.tipo === 'domicilio') { %>
      <div class="linea"><%= [pedido.direccion.calle, pedido.direccion.piso].filter(Boolean).join(', ') %></div>
      <div class="linea"><%= [pedido.direccion.cp && `CP ${pedido.direccion.cp}`, pedido.direccion.ciudad, pedido.direccion.provincia].filter(Boolean).join(' · ') %></div>
      <% if (pedido.direccion.referencias) { %><div class="chico">Referencias: <%= pedido.direccion.referencias %></div><% } %>
    <% } else { %>
      <div class="linea"><%= pedido.entrega.nombre %></div>
      <% if (ajustes.direccion) { %><div class="chico"><%= ajustes.direccion %></div><% } %>
    <% } %>
    <div class="linea">Tel.: <%= pedido.cliente.telefono %></div>
    <% if (pedido.cliente.email) { %><div class="chico"><%= pedido.cliente.email %></div><% } %>
  </div>

  <% if (pedido.entrega.tipo === 'domicilio' && (pedido.despacho.empresa || pedido.despacho.seguimiento)) { %>
    <h2>Envío</h2>
    <p><%= [pedido.despacho.empresa, pedido.despacho.seguimiento && `N.º ${pedido.despacho.seguimiento}`].filter(Boolean).join(' · ') %></p>
  <% } %>

  <h2>Productos</h2>
  <table>
    <thead><tr><th>Cant.</th><th>Producto</th><th class="num">Precio</th><th class="num">Subtotal</th></tr></thead>
    <tbody>
      <% for (const item of pedido.items) { %>
        <tr>
          <td><strong><%= item.cantidad %></strong></td>
          <td><%= item.nombre %><% if (item.detalle) { %> <span class="chico">(<%= item.detalle %>)</span><% } %><br><span class="chico">SKU <%= item.sku %></span></td>
          <td class="num"><%= formatearPrecio(item.precio) %></td>
          <td class="num"><%= formatearPrecio(item.precio * item.cantidad) %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <div class="totales">
    <div><span>Productos</span><span><%= formatearPrecio(pedido.subtotal) %></span></div>
    <% if (pedido.descuento) { %><div><span>Descuento <%= pedido.descuentoPorcentaje %>%</span><span>−<%= formatearPrecio(pedido.descuento) %></span></div><% } %>
    <div><span>Envío</span><span><%= pedido.envio === null ? 'A coordinar' : pedido.envio === 0 ? 'Gratis' : formatearPrecio(pedido.envio) %></span></div>
    <div class="final"><span>Total</span><span><%= formatearPrecio(pedido.total) %><%= pedido.envio === null ? ' + envío' : '' %></span></div>
  </div>

  <% if (pedido.notas) { %>
    <h2>Nota del cliente</h2>
    <p class="nota"><%= pedido.notas %></p>
  <% } %>

  <div class="casillas"><span>Productos controlados</span><span>Paquete cerrado</span><span>Etiqueta pegada</span></div>
</div>
</body>
</html>
