<%- include('../parciales/cabecera', { titulo: 'Revisar importación' }) %>
<header class="encabezado">
  <div>
    <h1>Revisá antes de confirmar</h1>
    <p class="texto-suave"><%- icono('planilla', { tamano: 16 }) %> <%= nombreArchivo %></p>
  </div>
</header>

<% if (errores.length > 0) { %>
  <section class="tarjeta tarjeta-error">
    <div class="tarjeta-titulo">
      <span class="tarjeta-titulo-icono" aria-hidden="true"><%- icono('alerta') %></span>
      <div>
        <h2>Encontramos <%= errores.length %> problema<%= errores.length === 1 ? '' : 's' %></h2>
        <p class="texto-suave">No se guardó nada. Corregí estas filas en el Excel y volvé a subirlo.</p>
      </div>
    </div>
    <div class="tabla-contenedor">
      <table class="tabla">
        <thead><tr><th scope="col">Fila</th><th scope="col">Problema</th></tr></thead>
        <tbody>
        <% for (const e of errores) { %>
          <tr><td class="celda-fila">Fila <%= e.fila %></td><td class="celda-envolver"><%= e.mensaje %></td></tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <div class="acciones"><a class="boton" href="/admin/importar"><%- icono('subir', { tamano: 18 }) %> Subir el archivo corregido</a></div>
  </section>
<% } else if (vacio) { %>
  <section class="tarjeta estado-vacio">
    <div class="estado-vacio-icono" aria-hidden="true"><%- icono('planilla', { tamano: 28 }) %></div>
    <h2>El archivo no tiene productos</h2>
    <p class="texto-suave">¿Completaste la hoja "Productos" de la plantilla?</p>
    <a class="boton" href="/admin/importar">Volver</a>
  </section>
<% } else { %>
  <section class="resumen" aria-label="Resumen de la importación">
    <div class="dato dato-destacado"><strong data-dato="productos-nuevos"><%= resumen.productosNuevos %></strong><span>productos nuevos</span></div>
    <div class="dato"><strong data-dato="productos-actualizados"><%= resumen.productosActualizados %></strong><span>productos a actualizar</span></div>
    <div class="dato dato-destacado"><strong data-dato="variantes-nuevas"><%= resumen.variantesNuevas %></strong><span>variantes nuevas</span></div>
    <div class="dato"><strong data-dato="variantes-actualizadas"><%= resumen.variantesActualizadas %></strong><span>variantes a actualizar</span></div>
  </section>
  <p class="ayuda">Las celdas vacías no cambian lo que ya está cargado. Los productos que no están en el archivo quedan como están.</p>
  <div class="acciones">
    <form method="post" action="/admin/importar/confirmar">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="boton boton-grande" type="submit"><%- icono('check', { tamano: 18 }) %> Confirmar importación</button>
    </form>
    <a class="boton boton-fantasma boton-grande" href="/admin/importar">Cancelar</a>
  </div>
<% } %>
<%- include('../parciales/pie') %>
